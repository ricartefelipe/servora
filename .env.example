# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Ports published on the host by docker-compose.yml -----------------------
WEB_PORT=3000
DB_PUBLISHED_PORT=55432
MAILPIT_UI_PORT=58025
MAILPIT_SMTP_PORT=51025

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_PASSWORD=postgres_local
DB_HOST=localhost
DB_PORT=55432
# Owner role: owns the schema, runs migrations (bin/db-prepare).
DB_OWNER_USER=servora_owner
DB_OWNER_PASSWORD=servora_owner_local
# Application role: runtime DML only, subject to Row-Level Security.
DB_APP_USER=servora_app
DB_APP_PASSWORD=servora_app_local

# --- Application ---------------------------------------------------------------
APP_HOST=localhost:3000
# Production only: generate with `bin/rails secret`.
# SECRET_KEY_BASE=
# Active Record encryption keys (production): generate with
# `bin/rails db:encryption:init` and store them in your secret manager.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- E-mail --------------------------------------------------------------------
SMTP_ADDRESS=localhost
SMTP_PORT=51025
MAILER_FROM=Servora <nao-responda@servora.local>

# --- Payments ------------------------------------------------------------------
# simulator (deterministic, local) or asaas (sandbox/production API).
PAYMENT_PROVIDER=simulator
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Organization-level Asaas API keys are stored encrypted in the database.

# --- Observability -------------------------------------------------------------
LOG_FORMAT=json
METRICS_TOKEN=local-metrics-token

# --- Object storage (production) -----------------------------------------------
# ACTIVE_STORAGE_SERVICE=object_storage
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

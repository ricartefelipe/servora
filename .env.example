# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# --- Ports published on the host by docker-compose.yml -----------------------
WEB_PORT=3000
DB_PUBLISHED_PORT=55432
MAILPIT_UI_PORT=58025
MAILPIT_SMTP_PORT=51025

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_PASSWORD=postgres_local
DB_HOST=localhost
DB_PORT=55432
# Owner role: owns the schema, runs migrations (bin/db-prepare).
DB_OWNER_USER=servora_owner
DB_OWNER_PASSWORD=servora_owner_local
# Application role: runtime DML only, subject to Row-Level Security.
DB_APP_USER=servora_app
DB_APP_PASSWORD=servora_app_local

# --- Application ---------------------------------------------------------------
APP_HOST=localhost:3000
# Production only: generate with `bin/rails secret`.
# SECRET_KEY_BASE=
# Active Record encryption keys (production): generate with
# `bin/rails db:encryption:init` and store them in your secret manager.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Public demonstration -----------------------------------------------------
# Only for an instance that holds nothing but demonstration data, wiped and
# re-seeded every day (docs/RUNBOOKS.md, "Demonstração pública"). Never set
# these on an instance that serves real customers.
#
# Demo mode (web and worker): only the exact value 1 enables it. It lists the
# seeded demonstration accounts and their password (SEED_PASSWORD) on the
# sign-in page and does not apply the MFA enrollment policy for privileged roles.
# On the worker it also starts a single-thread process for the "demo" queue
# (config/queue.yml), where the advance of today's story runs alone.
SERVORA_DEMO=0
# Seeding run (bin/db-prepare --seed): 1 records about six weeks of
# demonstration history (orders, visits, billing, stock, SLA) up to the moment
# of the run. Worker, with SERVORA_DEMO=1: 1 also schedules the advance of
# today's story every 5 minutes (Demo::AdvanceStoryJob), so the visits of the
# day are carried out at their times. Default: 1 in development, 0 elsewhere.
# The seeds never delete anything: run against a database that serves
# customers, they would add the fictitious organizations and their accounts to it.
# SEED_DEMO_ACTIVITY=0
# Password of the seeded demonstration accounts (db/seeds), shown on the
# sign-in page in demo mode. Set the same value for the seeding run and for
# web; it is public in demo mode, so never reuse it elsewhere.
# SEED_PASSWORD=servora-demo-2026
# Link to the demonstration inbox (web, demo mode). Default: /caixa-de-entrada,
# which the demo proxy must route to a read-only Mailpit; docker-compose.yml
# points it to the local Mailpit. Blank hides the link.
# SERVORA_DEMO_INBOX_URL=

# --- E-mail --------------------------------------------------------------------
SMTP_ADDRESS=localhost
SMTP_PORT=51025
MAILER_FROM=Servora <nao-responda@servora.local>

# --- Payments ------------------------------------------------------------------
# The provider is chosen per organization (Configurações → Pagamentos):
# "simulator" (deterministic, no network) or "asaas". Only the Asaas sandbox is
# supported; organization API keys are stored encrypted in the database.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# --- Platform billing (the Servora subscription itself) -----------------------
# simulator (default) or asaas. The platform's own Asaas account, never an
# organization's credentials. Notifications: POST /webhooks/plataforma/asaas.
PLATFORM_PAYMENT_PROVIDER=simulator
PLATFORM_ASAAS_API_KEY=
PLATFORM_ASAAS_WEBHOOK_TOKEN=

# --- Observability -------------------------------------------------------------
LOG_FORMAT=json
# /metrics is only available when this token is set (Authorization: Bearer).
METRICS_TOKEN=local-metrics-token
# Queries slower than this (ms) are counted and logged.
SLOW_QUERY_MS=500
# Shared directory for metrics when Puma runs several processes (optional).
PROMETHEUS_DATA_DIR=

# --- Object storage (production) -----------------------------------------------
# ACTIVE_STORAGE_SERVICE=object_storage
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

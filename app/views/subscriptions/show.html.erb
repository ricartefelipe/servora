<% content_for :title, "Assinatura" %>
<% module_names = @modules.to_h { |m| [m.code, m.name] } %>
<%= page_header("Assinatura do Servora", eyebrow: "Gestão · Assinatura", subtitle: "Plano da plataforma da sua empresa. Contratos de manutenção com seus clientes ficam em Contratos.") %>

<%# KPI strip. A full seat count stays ink and gets a danger badge, never a red number. %>
<% seats_full = @seats_in_use >= @subscription.technician_seats %>
<section class="mb-6 grid gap-px overflow-hidden rounded-[var(--radius-card)] bg-ink-150 ring-1 ring-ink-200 sm:grid-cols-3" aria-label="Resumo da assinatura">
  <div class="bg-white p-5">
    <p class="text-xs font-medium text-ink-600">Plano</p>
    <p class="mt-2 text-[28px] font-semibold leading-none tracking-tight text-ink-950"><%= @subscription.plan.name %></p>
    <p class="mt-2 text-xs text-ink-500"><%= @subscription.status_label %></p>
  </div>
  <div class="bg-white p-5">
    <p class="flex flex-wrap items-center gap-2 text-xs font-medium text-ink-600">Técnicos <% if seats_full %><%= badge("Sem vagas livres", tone: :danger) %><% end %></p>
    <p class="sv-num mt-2 text-[28px] font-semibold leading-none tracking-tight text-ink-950"><%= "#{@seats_in_use} de #{@subscription.technician_seats}" %></p>
    <p class="mt-2 text-xs text-ink-500">ativos e convidados / vagas</p>
  </div>
  <div class="bg-white p-5">
    <p class="text-xs font-medium text-ink-600">Mensalidade</p>
    <p class="sv-num mt-2 text-[28px] font-semibold leading-none tracking-tight text-ink-950"><%= money(@subscription.monthly_amount) %></p>
    <p class="mt-2 text-xs text-ink-500"><%= @subscription.status == "trialing" ? "após a avaliação" : "valor vigente" %></p>
  </div>
</section>

<% if @subscription.status == "past_due" %>
  <div class="mb-6 flex items-start gap-3 rounded-xl bg-rose-50 p-4 text-[13px] text-rose-800 ring-1 ring-inset ring-rose-600/20" role="alert">
    <%= icon(:alert, size: 18, css: "mt-px text-rose-600") %>
    <p class="min-w-0 flex-1">
      <strong class="font-semibold text-rose-900">Fatura vencida.</strong>
      Há fatura vencida há mais de <%= SubscriptionInvoice::GRACE_DAYS %> dias. Os dados seguem disponíveis para consulta; o registro de
      alterações volta assim que o pagamento for confirmado.
    </p>
  </div>
<% end %>

<% if @subscription.status == "trialing" %>
  <div class="mb-6 flex items-start gap-3 rounded-xl px-4 py-3 text-[13px] ring-1 ring-inset <%= @subscription.trial_expired? ? 'bg-rose-50 text-rose-800 ring-rose-600/20' : 'bg-sky-50 text-sky-800 ring-sky-600/20' %>" role="status">
    <% if @subscription.trial_expired? %>
      <%= icon(:alert, size: 18, css: "mt-px text-rose-600") %>
      <p class="min-w-0 flex-1">A avaliação terminou em <%= l(@subscription.trial_ends_on) %>. Os dados seguem disponíveis para consulta; ative a assinatura para voltar a registrar.</p>
    <% else %>
      <%= icon(:info, size: 18, css: "mt-px text-sky-600") %>
      <p class="min-w-0 flex-1">Avaliação com todos os módulos até <%= l(@subscription.trial_ends_on) %> (<%= pluralize(@subscription.trial_days_left, "dia") %>).</p>
    <% end %>
  </div>
<% end %>

<% if @invoices.any? %>
  <section class="sv-card mb-6 overflow-hidden" aria-labelledby="faturas-title">
    <h2 id="faturas-title" class="flex h-12 items-center border-b border-ink-150 px-5 text-[15px] font-semibold text-ink-950">Faturas da assinatura</h2>
    <ul class="divide-y divide-ink-150" role="list">
      <% @invoices.each do |invoice| %>
        <li class="flex flex-wrap items-center gap-3 px-5 py-3 text-[13px]">
          <div class="min-w-0 flex-1">
            <p class="font-medium text-ink-950"><%= l(invoice.period_start) %> a <%= l(invoice.period_end - 1) %> · <span class="sv-num"><%= money(invoice.amount) %></span></p>
            <p class="text-xs text-ink-500">Vence <%= l(invoice.due_on) %> · <%= invoice.lines.map { |line| line["description"] }.join(" + ") %>
              <% if invoice.last_error.present? %><span class="mt-0.5 flex items-center gap-1 text-rose-700"><%= icon(:alert, size: 12, css: "text-rose-600") %><%= invoice.last_error %></span><% end %></p>
          </div>
          <%= badge(invoice.status_label, tone: invoice.status == "paid" ? :success : (invoice.overdue? ? :danger : :warning)) %>
          <% if invoice.status == "open" && invoice.payment_url.present? %>
            <%= link_to "Pagar", invoice.payment_url, class: "sv-btn-secondary sv-btn-sm", target: "_blank", rel: "noopener noreferrer" %>
          <% end %>
          <% if @simulated_billing && invoice.status == "open" && invoice.charge_status == "submitted" %>
            <%= button_to "Simular pagamento", simulate_subscription_invoice_payment_path(invoice), class: "sv-btn-secondary sv-btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= form_with url: subscription_path, method: :patch, scope: :subscription, class: "space-y-6" do |f| %>
  <fieldset class="grid gap-4 md:grid-cols-3">
    <legend class="sr-only">Plano</legend>
    <% @plans.each do |plan| %>
      <%# Selected plan: sand surface plus a thin ruby ring as the mark. %>
      <label class="sv-card relative flex cursor-pointer flex-col gap-2 p-5 transition-colors duration-150 hover:bg-ink-25 has-[:checked]:bg-select has-[:checked]:ring-ink-400 has-[:checked]:shadow-[inset_3px_0_0_var(--color-brand-600)]">
        <%= f.radio_button :plan_code, plan.code, checked: plan.id == @subscription.plan_id, class: "absolute right-4 top-4 size-4" %>
        <span class="text-[15px] font-semibold text-ink-950"><%= plan.name %></span>
        <span class="sv-num text-[28px] font-semibold leading-tight tracking-tight text-ink-950"><%= money(plan.monthly_price) %><span class="text-[13px] font-normal tracking-normal text-ink-500">/mês</span></span>
        <span class="text-[13px] text-ink-600"><%= plan.included_technicians %> técnicos incluídos · <%= money(plan.extra_technician_price) %> por técnico adicional</span>
        <span class="text-[13px] text-ink-600">Módulos: <%= plan.modules.map { |code| module_names[code] }.to_sentence.presence || "ordens, agenda, clientes, orçamentos e portal" %></span>
        <span class="text-xs text-ink-500">Implantação e treinamento: <%= plan.implementation_fee.positive? ? money(plan.implementation_fee) : "incluídos" %></span>
      </label>
    <% end %>
  </fieldset>

  <section class="sv-card grid gap-5 p-6 sm:grid-cols-2" aria-labelledby="ajustes-title">
    <h2 id="ajustes-title" class="text-[15px] font-semibold text-ink-950 sm:col-span-2">Vagas e módulos adicionais</h2>
    <div>
      <%= f.label :seats, "Vagas de técnico", class: "sv-label" %>
      <%= f.number_field :seats, value: @subscription.technician_seats, min: [@seats_in_use, 1].max, class: "sv-input", required: true %>
      <p class="sv-hint mt-1">Não pode ser menor que os técnicos ativos e convidados (<%= @seats_in_use %>).</p>
    </div>
    <fieldset>
      <legend class="sv-label">Módulos adicionais</legend>
      <div class="space-y-2 text-[13px] text-ink-700">
        <% @modules.each do |mod| %>
          <label class="flex items-center gap-2">
            <%= check_box_tag "subscription[addons][]", mod.code, @subscription.addon_modules.include?(mod.code), id: "modulo-#{mod.code}", class: "size-4 rounded border-ink-400" %>
            <%= mod.name %> <span class="text-ink-500">(<%= money(mod.monthly_price) %>/mês, se não incluso no plano)</span>
          </label>
        <% end %>
      </div>
    </fieldset>
  </section>

  <div class="flex flex-wrap justify-end gap-3">
    <%= f.button "Salvar alterações", type: "submit", class: "sv-btn-secondary" %>
    <% unless @subscription.status == "active" %>
      <%= f.button "Ativar assinatura", type: "submit", name: "ativar", value: "1", class: "sv-btn-primary",
            data: { turbo_confirm: "Ativar a assinatura com o plano e as vagas selecionados?" } %>
    <% end %>
  </div>
<% end %>

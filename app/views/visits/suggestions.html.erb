<%= turbo_frame_tag "visit-suggestions" do %>
  <% if @result.nil? %>
    <p class="text-sm text-ink-500">Informe data e horário válidos.</p>
  <% else %>
    <% if @result.ranked.empty? %>
      <p class="flex items-start gap-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-600/20"><%= icon(:clock, size: 16, css: "mt-0.5 shrink-0 text-amber-600") %> Nenhum técnico atende a este horário.</p>
    <% else %>
      <ol class="space-y-2" role="list">
        <% @result.ranked.each_with_index do |candidate, index| %>
          <li class="flex items-center gap-2 rounded-lg bg-ink-25 px-3 py-2 text-sm ring-1 ring-inset ring-ink-150">
            <span class="sv-num grid size-6 shrink-0 place-items-center rounded-full bg-white font-mono text-[11px] font-semibold text-ink-800 ring-1 ring-inset ring-ink-200"><%= index + 1 %></span>
            <span class="flex-1 font-medium text-ink-950"><%= candidate.name %></span>
            <span class="sv-num font-mono text-xs text-ink-500"><%= candidate.booked_minutes %> min no dia</span>
          </li>
        <% end %>
      </ol>
    <% end %>
    <% if @result.others.any? %>
      <details class="mt-3">
        <summary class="cursor-pointer text-xs font-medium text-ink-600 hover:text-ink-950">Indisponíveis (<%= @result.others.size %>)</summary>
        <ul class="mt-2 space-y-1 text-xs text-ink-500" role="list">
          <% @result.others.each do |candidate, reasons| %>
            <li><span class="font-medium text-ink-700"><%= candidate.name %>:</span> <%= reasons.join("; ") %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% end %>
<% end %>

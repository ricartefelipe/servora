<% content_for :title, "Agendar visita" %>
<%= page_header("Agendar visita", eyebrow: "Operação · Ordens de serviço", size: :md, subtitle: "#{@work_order.number} · #{@work_order.title} · #{@work_order.customer.display_name}") %>
<div class="grid gap-6 lg:grid-cols-3" data-controller="suggestions" data-suggestions-url-value="<%= suggestions_work_order_visits_path(@work_order) %>">
  <%= form_with url: work_order_visits_path(@work_order), scope: :visit, class: "sv-card space-y-5 p-6 lg:col-span-2" do |f| %>
    <div class="grid gap-4 sm:grid-cols-4">
      <div><%= f.label :date, "Data", class: "sv-label" %><%= f.date_field :date, value: @starts_at.to_date, class: "sv-input", required: true, data: { suggestions_target: "date", action: "change->suggestions#refresh" } %></div>
      <div><%= f.label :start_time, "Início", class: "sv-label" %><%= f.time_field :start_time, value: @starts_at.strftime("%H:%M"), step: 900, class: "sv-input", required: true, data: { suggestions_target: "time", action: "change->suggestions#refresh" } %></div>
      <div><%= f.label :duration_minutes, "Duração (min)", class: "sv-label" %><%= f.number_field :duration_minutes, value: 90, min: 15, max: 720, step: 15, class: "sv-input", data: { suggestions_target: "duration", action: "change->suggestions#refresh" } %></div>
      <div><%= f.label :travel_minutes, "Deslocamento (min)", class: "sv-label" %><%= f.number_field :travel_minutes, value: current_organization.travel_buffer_minutes, min: 0, max: 480, step: 5, class: "sv-input" %></div>
    </div>
    <fieldset>
      <legend class="sv-label">Técnicos</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <% current_organization.memberships.technicians.includes(:user).ordered.each do |technician| %>
          <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-ink-200 bg-white px-3 py-2 text-sm text-ink-900 transition-colors hover:bg-ink-25 has-[:checked]:border-ink-400 has-[:checked]:bg-select has-[:checked]:shadow-[inset_2px_0_0_var(--color-brand-600)]">
            <%= check_box_tag "visit[technician_ids][]", technician.id, @work_order.assignments.any? { |a| a.membership_id == technician.id }, id: "tecnico_#{technician.id}", class: "rounded border-ink-400" %>
            <%= technician.user.name %>
          </label>
        <% end %>
      </div>
    </fieldset>
    <% teams = current_organization.teams.active.alphabetical %>
    <% if teams.any? %>
      <div><%= f.label :team_id, "Ou uma equipe inteira", class: "sv-label" %><%= f.select :team_id, teams.map { |t| [t.name, t.id] }, { include_blank: "Nenhuma" }, class: "sv-input" %></div>
    <% end %>
    <div><%= f.label :notes, "Observações para a equipe", class: "sv-label" %><%= f.text_area :notes, rows: 2, class: "sv-input" %></div>
    <%= render "shared/form_footer", f:, submit: "Agendar", cancel_url: work_order_path(@work_order), submits_with: false, sticky: true %>
  <% end %>
  <aside class="sv-card p-5" aria-labelledby="sugestoes-title">
    <h2 id="sugestoes-title" class="text-[15px] font-semibold text-ink-950">Técnicos sugeridos</h2>
    <p class="mt-1 text-xs text-ink-500">Por competência exigida, disponibilidade e menor carga no dia. Não é otimização de rotas.</p>
    <%= turbo_frame_tag "visit-suggestions", src: suggestions_work_order_visits_path(@work_order, date: @starts_at.to_date, start_time: @starts_at.strftime("%H:%M"), duration_minutes: 90),
          loading: :lazy, class: "mt-4 block", data: { suggestions_target: "frame" } do %>
      <p class="text-sm text-ink-500">Carregando sugestões…</p>
    <% end %>
  </aside>
</div>

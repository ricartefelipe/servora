<%# Open work orders by status: one stacked bar, a legend and the data table.
    Groups follow the status hue (ember, indigo, neutral, amber) so the two
    warm hues, in progress and waiting, never touch unless nothing sits between them. %>
<% fills = { ember: "fill-ember-500", indigo: "fill-indigo-500", neutral: "fill-ink-400", warning: "fill-amber-500" } %>
<% tone_order = fills.keys %>
<% slices = slices.each_with_index.sort_by { |slice, index| [tone_order.index(work_order_status_tone(slice.status)) || tone_order.size, index] }.map(&:first) %>
<% total = slices.sum(&:count) %>
<section class="sv-card min-w-0" aria-labelledby="os-situacao-titulo">
  <header class="flex h-12 items-center justify-between border-b border-ink-150 px-5">
    <h2 id="os-situacao-titulo" class="text-[15px] font-semibold text-ink-950">OS por situação</h2>
    <%= link_to work_orders_path, class: "sv-btn-ghost sv-btn-sm" do %>Ver ordens<%= icon(:chevron_right, size: 14) %><% end %>
  </header>
  <% if total.zero? %>
    <p class="px-5 py-6 text-[13px] text-ink-600">Nenhuma ordem de serviço em aberto.</p>
  <% else %>
    <% width = 1000.0 %>
    <% min_width = 8.0 %>
    <% small = slices.select { |slice| slice.count * width / total < min_width } %>
    <% share = (width - (min_width * small.size)) / (total - small.sum(&:count)) %>
    <% x = 0.0 %>
    <% segments = slices.map do |slice|
         w = small.include?(slice) ? min_width : slice.count * share
         segment = { slice:, x: x.round(2), width: w.round(2), fill: fills.fetch(work_order_status_tone(slice.status), fills[:neutral]) }
         x += w
         segment
       end %>
    <% summary = slices.map { |slice| "#{slice.count} #{slice.label.downcase}" }.join(", ") %>
    <div class="px-5 pb-5 pt-4">
      <p class="flex items-baseline gap-2">
        <span class="sv-num text-[28px] font-semibold leading-none text-ink-950"><%= total %></span>
        <span class="text-[13px] text-ink-600"><%= total == 1 ? "ordem em aberto" : "ordens em aberto" %></span>
      </p>
      <div class="mt-4 overflow-hidden rounded-sm">
        <svg class="block h-3 w-full" viewBox="0 0 1000 12" preserveAspectRatio="none" role="img"
             aria-label="<%= "OS em aberto por situação: #{summary}." %>">
          <% segments.each do |segment| %>
            <rect class="<%= segment[:fill] %>" x="<%= segment[:x] %>" y="0" width="<%= segment[:width] %>" height="12"><title><%= segment[:slice].label %>: <%= segment[:slice].count %></title></rect>
          <% end %>
          <%# 2px gaps in the card surface colour, constant whatever the bar width. %>
          <% segments.drop(1).each do |segment| %>
            <line class="stroke-white" x1="<%= segment[:x] %>" x2="<%= segment[:x] %>" y1="0" y2="12" stroke-width="2" vector-effect="non-scaling-stroke" />
          <% end %>
        </svg>
      </div>
      <ul class="mt-4 grid gap-x-6 gap-y-1 sm:grid-cols-2" role="list" aria-label="Legenda">
        <% slices.each do |slice| %>
          <li>
            <%= link_to work_orders_path(situacao: slice.status), class: "-mx-2 flex min-h-8 items-center gap-2 rounded-md px-2 text-[13px] text-ink-800 hover:bg-ink-25 hover:text-ink-950" do %>
              <span class="size-2 shrink-0 rounded-full <%= UiHelper::DOT_TONES.fetch(work_order_status_tone(slice.status)) %>" aria-hidden="true"></span>
              <span class="min-w-0 flex-1 truncate"><%= slice.label %></span>
              <span class="sv-num font-mono text-xs text-ink-700"><%= slice.count %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <details class="mt-3 border-t border-ink-150 pt-3">
        <summary class="sv-link cursor-pointer text-[13px]">Ver dados</summary>
        <div class="mt-3 overflow-x-auto">
          <table class="sv-table">
            <caption class="sr-only">Ordens de serviço em aberto por situação</caption>
            <thead>
              <tr><th scope="col">Situação</th><th scope="col" class="text-right"><span class="sm:hidden">Qtd.</span><span class="max-sm:hidden">Quantidade</span></th><th scope="col" class="text-right"><span class="sm:hidden">%</span><span class="max-sm:hidden">Participação</span></th></tr>
            </thead>
            <tbody>
              <% slices.each do |slice| %>
                <tr>
                  <th scope="row" class="h-auto py-3 text-[13px] font-normal normal-case tracking-normal text-ink-800"><%= slice.label %></th>
                  <td class="sv-num text-right"><%= slice.count %></td>
                  <td class="sv-num text-right"><%= number_to_percentage(slice.count * 100.0 / total, precision: 0) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="border-t border-ink-150">
                <th scope="row" class="h-auto py-3 text-[13px] font-semibold normal-case tracking-normal text-ink-950">Total</th>
                <td class="sv-num px-4 py-3 text-right font-semibold text-ink-950"><%= total %></td>
                <td class="sv-num px-4 py-3 text-right font-semibold text-ink-950">100%</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </details>
    </div>
  <% end %>
</section>

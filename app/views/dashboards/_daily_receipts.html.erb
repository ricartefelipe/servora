<%# Net money received per day over the last week. Past days in ink, today in
    ruby (the only ruby mark of the row). Each day is its own SVG so bars and
    value labels keep their true size at any card width. %>
<% day_names = %w[dom seg ter qua qui sex sáb] %>
<% total = receipts.sum(&:amount) %>
<% peak = receipts.map(&:amount).max %>
<% plot_height = 132 %>
<% bar_room = 108 %>
<% bar_width = 28 %>
<% compact = lambda do |value|
     if value >= 1_000_000 then "#{number_with_precision(value / 1_000_000, precision: 1, separator: ',', strip_insignificant_zeros: true)} mi"
     elsif value >= 1_000 then "#{number_with_precision(value / 1_000, precision: 1, separator: ',', strip_insignificant_zeros: true)} mil"
     else number_with_precision(value, precision: 0, delimiter: ".")
     end
   end %>
<section class="sv-card min-w-0" aria-labelledby="recebido-titulo">
  <header class="flex h-12 items-center justify-between gap-3 border-b border-ink-150 px-5">
    <h2 id="recebido-titulo" class="min-w-0 truncate text-[15px] font-semibold text-ink-950">Recebido · últimos 7 dias</h2>
    <%= link_to receivables_path, class: "sv-btn-ghost sv-btn-sm shrink-0", aria: { label: "Ver financeiro" } do %><span class="max-sm:sr-only">Ver financeiro</span><%= icon(:chevron_right, size: 14) %><% end %>
  </header>
  <div class="px-5 pb-5 pt-4">
    <% if total.zero? %>
      <p class="py-2 text-[13px] text-ink-600">Nenhum recebimento nos últimos 7 dias.</p>
    <% else %>
      <p class="flex flex-wrap items-baseline gap-x-2">
        <span class="sv-num text-[28px] font-semibold leading-none text-ink-950"><%= money(total) %></span>
        <span class="text-[13px] text-ink-600">no período, já descontados os estornos</span>
      </p>
      <% best = receipts.max_by(&:amount) %>
      <% today = receipts.find(&:today) %>
      <% summary = "Recebido nos últimos 7 dias: #{money(total)}. Hoje: #{money(today&.amount)}. " \
                   "Maior valor: #{money(best.amount)} em #{l(best.date, format: '%A, %d/%m')}." %>
      <%# The bars are drawn for sight; assistive technology gets the summary caption and the data table. %>
      <figure class="mt-5">
        <figcaption class="sr-only"><%= summary %></figcaption>
        <div class="grid grid-cols-7" aria-hidden="true">
        <% receipts.each do |receipt| %>
          <% height = receipt.amount.positive? ? [(receipt.amount / peak * bar_room).to_f.round(1), 2].max : 0 %>
          <% top = plot_height - height %>
          <% radius = [4, height].min %>
          <div class="flex flex-col items-center">
            <svg class="h-[132px] w-7 overflow-visible" viewBox="0 0 <%= bar_width %> <%= plot_height %>" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
              <% if height.positive? %>
                <path class="<%= receipt.today ? 'fill-brand-600' : 'fill-ink-400' %>"
                      d="M0 <%= plot_height %>V<%= top + radius %>a<%= radius %> <%= radius %> 0 0 1 <%= radius %> -<%= radius %>H<%= bar_width - radius %>a<%= radius %> <%= radius %> 0 0 1 <%= radius %> <%= radius %>V<%= plot_height %>Z"><title><%= l(receipt.date, format: "%A, %d/%m") %>: <%= money(receipt.amount) %></title></path>
                <text class="<%= receipt.today ? 'fill-ink-950 font-semibold' : 'fill-ink-600 max-sm:hidden' %> font-mono text-[11px]"
                      x="<%= bar_width / 2 %>" y="<%= top - 6 %>" text-anchor="middle"><%= compact.call(receipt.amount) %></text>
              <% end %>
            </svg>
            <span class="mt-2 w-full border-t border-ink-200 pt-1.5 text-center font-mono text-[11px] <%= receipt.today ? 'font-semibold text-ink-950' : 'text-ink-500' %>"><%= receipt.today ? "hoje" : day_names[receipt.date.wday] %></span>
          </div>
        <% end %>
        </div>
      </figure>
      <details class="mt-3 border-t border-ink-150 pt-3">
        <summary class="sv-link cursor-pointer text-[13px]">Ver dados</summary>
        <div class="mt-3 overflow-x-auto">
          <table class="sv-table">
            <caption class="sr-only">Recebido por dia nos últimos 7 dias, já descontados os estornos</caption>
            <thead>
              <tr><th scope="col">Dia</th><th scope="col" class="text-right">Recebido</th></tr>
            </thead>
            <tbody>
              <% receipts.each do |receipt| %>
                <tr>
                  <th scope="row" class="h-auto py-3 text-[13px] font-normal normal-case tracking-normal text-ink-800"><%= l(receipt.date, format: "%A, %d/%m") %><% if receipt.today %> (hoje)<% end %></th>
                  <td class="sv-num text-right text-ink-950"><%= money(receipt.amount) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="border-t border-ink-150">
                <th scope="row" class="h-auto px-4 py-3 text-left text-[13px] font-semibold normal-case tracking-normal text-ink-950">Total</th>
                <td class="sv-num px-4 py-3 text-right font-semibold text-ink-950"><%= money(total) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </details>
    <% end %>
  </div>
</section>

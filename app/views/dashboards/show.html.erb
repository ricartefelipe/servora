<% content_for :title, "Painel" %>
<%= page_header("Olá, #{current_user.name.split.first}", eyebrow: current_organization.name,
      subtitle: "Visão geral da operação de hoje, #{l(Date.current, format: :long)}.") %>

<% if @overview.show_onboarding? %>
  <section class="sv-card mb-8 overflow-hidden" aria-labelledby="onboarding-title">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-ink-100 bg-gradient-to-r from-brand-50 to-white px-6 py-5">
      <div>
        <h2 id="onboarding-title" class="font-semibold text-ink-900">Primeiros passos</h2>
        <p class="text-sm text-ink-600">Deixe o Servora pronto para a sua operação.</p>
      </div>
      <%= button_to "Concluir primeiros passos", complete_onboarding_settings_path, method: :patch, class: "sv-btn-secondary sv-btn-sm" %>
    </div>
    <ol class="grid gap-px bg-ink-100 sm:grid-cols-2 xl:grid-cols-4">
      <% @overview.onboarding_steps.each_with_index do |step, index| %>
        <li class="flex gap-4 bg-white p-5">
          <span class="grid size-8 shrink-0 place-items-center rounded-full text-sm font-bold <%= step.done ? 'bg-emerald-600 text-white' : 'bg-ink-100 text-ink-600' %>">
            <%= step.done ? icon(:check, size: 16, label: "Concluído") : index + 1 %>
          </span>
          <div>
            <%= link_to step.title, public_send(step.path_helper), class: "font-medium text-ink-900 hover:text-brand-700" %>
            <p class="mt-0.5 text-sm text-ink-600"><%= step.description %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>

<% if current_subscription&.status == "trialing" && can?(:subscription_manage) %>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900" role="status">
    <span><% if current_subscription.trial_expired? %>A avaliação terminou. Os dados seguem disponíveis para consulta.<% else %>Avaliação: <%= pluralize(current_subscription.trial_days_left, "dia restante", plural: "dias restantes") %> com todos os módulos.<% end %></span>
    <%= link_to "Ver assinatura", subscription_path, class: "sv-btn-primary sv-btn-sm" %>
  </div>
<% end %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% if (customers = @overview.active_customers_count) %>
    <%= stat_tile("Clientes ativos", customers) %>
  <% end %>
  <% alerts = @overview.equipment_alerts %>
  <% if can?(:customers_view) %>
    <%= stat_tile("Equipamentos parados", alerts["inoperative"] || 0, tone: (alerts["inoperative"].to_i.positive? ? :danger : :neutral),
          hint: "#{alerts['attention'] || 0} requerem atenção") %>
  <% end %>
  <% if (sla = @overview.sla_alerts) %>
    <%= stat_tile("Prazos estourados", sla[:breached], tone: sla[:breached].positive? ? :danger : :neutral,
          hint: "#{sla[:at_risk]} em risco (SLA)") %>
  <% end %>
  <%= stat_tile("Membros ativos", @overview.active_members_count) %>
  <% if (pending = @overview.pending_invitations_count) %>
    <%= stat_tile("Convites pendentes", pending) %>
  <% end %>
</div>

<% content_for :title, "Segurança da conta" %>
<% content_for :container_width, "max-w-2xl" %>
<%= page_header("Segurança da conta", eyebrow: "Conta · Segurança", subtitle: current_user.email) %>

<section class="sv-card mb-6 p-6" aria-labelledby="mfa-title">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 id="mfa-title" class="text-[15px] font-semibold text-ink-950">Verificação em duas etapas</h2>
      <p class="mt-1 text-[13px] text-ink-600">Código temporário de um aplicativo autenticador exigido a cada login.</p>
    </div>
    <%= current_user.mfa_enabled? ? badge("Ativa", tone: :success) : badge("Inativa", tone: :warning) %>
  </div>
  <div class="mt-5">
    <% if current_user.mfa_enabled? %>
      <details class="group">
        <summary class="sv-btn-secondary cursor-pointer list-none">Desativar verificação</summary>
        <%= form_with url: account_two_factor_path, method: :delete, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
          <div class="min-w-56 flex-1">
            <%= f.label :current_password, "Confirme com sua senha", class: "sv-label" %>
            <%= f.password_field :current_password, class: "sv-input", required: true, autocomplete: "current-password" %>
          </div>
          <%= f.button type: "submit", class: "sv-btn-danger" do %><%= icon(:alert, size: 16) %> Desativar<% end %>
        <% end %>
      </details>
    <% else %>
      <%= link_to "Ativar verificação em duas etapas", new_account_two_factor_path, class: "sv-btn-primary" %>
    <% end %>
  </div>
</section>

<section class="sv-card p-6" aria-labelledby="sessions-title">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 id="sessions-title" class="text-[15px] font-semibold text-ink-950">Sessões ativas</h2>
      <p class="mt-1 text-[13px] text-ink-600">Encerre acessos que você não reconhece.</p>
    </div>
    <% if @sessions.size > 1 %>
      <%= button_to others_account_sessions_path, method: :delete, class: "sv-btn-danger sv-btn-sm" do %><%= icon(:logout, size: 14) %> Encerrar as demais<% end %>
    <% end %>
  </div>
  <ul class="divide-y divide-ink-150" role="list">
    <% @sessions.each do |user_session| %>
      <li class="flex flex-wrap items-center gap-3 py-3">
        <% device_label, device_icon = session_device(user_session.user_agent) %>
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-ink-100 text-ink-700" aria-hidden="true"><%= icon(device_icon, size: 16) %></span>
        <div class="min-w-0 flex-1 [contain:inline-size]">
          <p class="truncate text-[13px] font-medium text-ink-950" title="<%= user_session.user_agent %>"><%= device_label %></p>
          <p class="text-xs text-ink-500">IP <span class="font-mono"><%= user_session.ip_address %></span> · <span class="whitespace-nowrap">último acesso <%= l(user_session.last_seen_at, format: :short) %></span></p>
        </div>
        <% if user_session.id == @current_session_id %>
          <%= badge("Esta sessão", dot: false) %>
        <% else %>
          <%= button_to account_session_path(user_session), method: :delete, class: "sv-btn-ghost sv-btn-sm" do %><%= icon(:logout, size: 14) %> Encerrar<% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<div class="mt-6 flex flex-wrap gap-3 text-sm">
  <%= link_to "Meus dados e senha", edit_user_registration_path, class: "sv-link" %>
  <%= link_to "Voltar às organizações", organizations_path(escolher: 1), class: "sv-link" %>
</div>

<% title = @title || "Acesso indisponível" %>
<% content_for :title, title %>
<div class="mx-auto max-w-md sv-card p-8 text-center">
  <h1 class="text-xl font-bold text-ink-950"><%= title %></h1>
  <p class="mt-3 text-sm text-ink-600"><%= @message || "Sua sessão terminou ou o link não é mais válido. Peça um novo link à empresa que atende você." %></p>
</div>

<% content_for :title, "Cobranças" %>
<h1 class="text-2xl font-bold tracking-tight text-ink-950">Cobranças</h1>
<p class="mb-6 text-sm text-ink-600">Valores dos atendimentos. Este demonstrativo não é nota fiscal; quando emitida, a NFS-e fica disponível em cada cobrança.</p>
<% if @receivables.empty? %>
  <div class="sv-card"><%= empty_state("Nenhuma cobrança", icon_name: :finance) %></div>
<% else %>
  <ul class="space-y-3" role="list">
    <% @receivables.each do |receivable| %>
      <% charge = @charges[receivable.id] %>
      <li class="sv-card flex flex-wrap items-center gap-4 p-4">
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-ink-900"><%= receivable.description %></p>
          <p class="text-sm text-ink-500"><%= receivable.number %> · vence <%= l(receivable.due_on) %></p>
        </div>
        <div class="text-right">
          <p class="sv-num font-semibold text-ink-900"><%= money(receivable.balance.positive? ? receivable.balance : receivable.amount - receivable.discount_amount) %></p>
          <%= render "receivables/status_badge", receivable: %>
        </div>
        <% if (invoice = @invoices[receivable.id]) %>
          <%= link_to "Nota fiscal", invoice.pdf_url, class: "sv-btn-secondary", target: "_blank", rel: "noopener noreferrer" %>
        <% end %>
        <% if charge && receivable.outstanding? %>
          <%= link_to "Pagar", charge.payment_url, class: "sv-btn-primary", target: "_blank", rel: "noopener noreferrer" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% content_for :title, @work_order.number %>
<p class="font-mono text-xs font-semibold uppercase tracking-wider text-brand-700"><%= @work_order.number %></p>
<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <h1 class="text-2xl font-bold tracking-tight text-ink-950"><%= @work_order.title %></h1>
  <%= render "portal/work_orders/status", work_order: @work_order %>
</div>

<div class="grid gap-6 md:grid-cols-3">
  <div class="min-w-0 space-y-6 md:col-span-2">
    <section class="sv-card p-5 text-sm" aria-labelledby="pedido-title">
      <h2 id="pedido-title" class="mb-2 font-semibold text-ink-900">Pedido</h2>
      <p class="whitespace-pre-line text-ink-700"><%= @work_order.problem_description %></p>
      <p class="mt-3 text-xs text-ink-500">Aberto em <%= l(@work_order.requested_at, format: :short) %> · <%= @work_order.service_location.name %></p>
      <% if @work_order.equipment.any? %><p class="mt-1 text-xs text-ink-500">Equipamentos: <%= @work_order.equipment.map(&:title).to_sentence %></p><% end %>
    </section>

    <section class="sv-card p-5 text-sm" aria-labelledby="relatorios-title">
      <h2 id="relatorios-title" class="mb-2 font-semibold text-ink-900">Relatórios de execução</h2>
      <% if @reports.empty? %>
        <p class="text-ink-500">O relatório fica disponível quando o atendimento for concluído.</p>
      <% else %>
        <ul class="space-y-2" role="list">
          <% @reports.each do |report| %>
            <li class="flex items-center justify-between gap-3">
              <span class="text-ink-700">Versão <%= report.version_number %> · <%= l(report.created_at.to_date) %></span>
              <%= link_to portal_work_order_report_path(@work_order, report), class: "sv-btn-secondary sv-btn-sm", data: { turbo: false } do %><%= icon(:download, size: 16) %> PDF<% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>

  <aside class="sv-card p-5 text-sm" aria-labelledby="visitas-title">
    <h2 id="visitas-title" class="mb-2 font-semibold text-ink-900">Visitas</h2>
    <% if @visits.empty? %>
      <p class="text-ink-500">Nenhuma visita marcada ainda.</p>
    <% else %>
      <ul class="space-y-2" role="list">
        <% @visits.each do |visit| %>
          <li>
            <p class="font-medium text-ink-900"><%= l(visit.scheduled_start, format: :short) %></p>
            <p class="text-xs text-ink-500"><%= Visits::LABELS.fetch(visit.status) %> · até <%= l(visit.scheduled_end, format: "%H:%M") %></p>
          </li>
        <% end %>
      </ul>
    <% end %>
  </aside>
</div>

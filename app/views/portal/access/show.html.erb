<% content_for :title, "Acesso" %>
<div class="mx-auto max-w-md sv-card p-8 text-center animate-slide-up">
  <div class="relative mx-auto mb-5 grid size-12 place-items-center rounded-xl bg-white text-ink-700 ring-1 ring-ink-200"><%= icon(:key, size: 22) %><span class="sv-facet absolute -right-0.5 -top-0.5 size-2" aria-hidden="true"></span></div>
  <h1 class="sv-display text-display-md text-ink-950">Acessar o portal de <%= @organization_name %></h1>
  <p class="mt-3 text-sm text-ink-600">Por segurança, o link pode ser usado uma única vez. Ao continuar, uma sessão restrita será aberta neste navegador por até 12 horas.</p>
  <%# A full page load after the session reset keeps the CSP nonce consistent. %>
  <%= button_to "Continuar", portal_access_path(@token), method: :post, form: { data: { turbo: false } }, class: "sv-btn-primary mt-6 h-11 w-full text-sm" %>
</div>

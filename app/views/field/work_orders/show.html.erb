<% content_for :title, @work_order.number %>
<% zone = current_organization.zone %>
<div data-controller="service-worker"></div>
<div class="mx-auto max-w-2xl space-y-5"
     data-controller="field-sync" data-field-sync-url-value="<%= field_operations_path %>"
     data-field-sync-context-key-value="<%= local_context_key %>" data-field-sync-work-order-id-value="<%= @work_order.id %>">
  <nav aria-label="Voltar"><%= link_to "← Minha agenda", field_root_path, class: "sv-link text-sm" %></nav>
  <header>
    <p class="font-mono text-xs font-semibold uppercase tracking-wider text-brand-700"><%= @work_order.number %> · <%= @work_order.status_label %></p>
    <h1 class="text-2xl font-bold tracking-tight text-ink-950"><%= @work_order.title %></h1>
    <p class="text-ink-600"><%= @work_order.customer.display_name %></p>
  </header>

  <div class="rounded-2xl border border-ink-200 bg-white p-3 text-sm" role="status" aria-live="polite">
    <p data-field-sync-target="status" class="text-ink-700">Pronto para registrar.</p>
    <p data-field-sync-target="pending" class="text-xs text-ink-500" hidden></p>
  </div>

  <section class="sv-card p-4 text-sm" aria-labelledby="local-title">
    <h2 id="local-title" class="font-semibold text-ink-900">Local</h2>
    <p class="text-ink-700"><%= @work_order.service_location.address_line %></p>
    <p class="text-ink-500"><%= @work_order.service_location.city_line %></p>
    <% if @work_order.service_location.access_instructions.present? %><p class="mt-2 rounded-xl bg-amber-50 p-2 text-amber-900"><%= @work_order.service_location.access_instructions %></p><% end %>
    <%= link_to "Abrir no mapa", "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([@work_order.service_location.address_line, @work_order.service_location.city_line].join(', '))}",
          class: "sv-btn-secondary sv-btn-sm mt-3", target: "_blank", rel: "noopener noreferrer" %>
    <% if @work_order.equipment.any? %>
      <p class="mt-3 text-ink-700"><strong>Equipamentos:</strong> <%= @work_order.equipment.map(&:title).to_sentence %></p>
    <% end %>
    <p class="mt-3 whitespace-pre-line text-ink-700"><strong>Problema:</strong> <%= @work_order.problem_description %></p>
  </section>

  <% if @can_execute && @visits.any? %>
    <section class="sv-card space-y-3 p-4" aria-labelledby="visita-title">
      <h2 id="visita-title" class="font-semibold text-ink-900">Visita</h2>
      <% @visits.each do |visit| %>
        <p class="text-sm text-ink-600"><%= l(visit.scheduled_start.in_time_zone(zone), format: :short) %></p>
        <% if visit.status == "scheduled" %>
          <%= button_to "Iniciar visita", start_work_order_visit_path(@work_order, visit, origem: "campo"), method: :patch, class: "sv-btn-primary w-full py-3" %>
        <% elsif visit.status == "in_progress" %>
          <%= form_with url: finish_work_order_visit_path(@work_order, visit, origem: "campo"), method: :patch, scope: :finish, class: "space-y-2" do |f| %>
            <%= f.label :outcome_note, "Resumo da visita", class: "sv-label" %>
            <%= f.text_area :outcome_note, rows: 2, class: "sv-input" %>
            <label class="flex items-center gap-2 text-sm text-ink-700"><%= f.check_box :needs_return, class: "rounded border-ink-300 text-brand-600" %> Precisa de retorno</label>
            <%= f.button "Finalizar visita", type: "submit", class: "sv-btn-primary w-full py-3" %>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if @work_order.checklist_items.any? %>
    <section class="sv-card p-4" aria-labelledby="checklist-title">
      <h2 id="checklist-title" class="mb-2 font-semibold text-ink-900">Checklist</h2>
      <ul class="divide-y divide-ink-100" role="list">
        <% @work_order.checklist_items.each do |item| %>
          <li class="py-3">
            <%= form_with url: field_operations_path, scope: :checklist, class: "space-y-2",
                  data: { kind: "checklist", version: item.lock_version, item_id: item.id, draft_id: "checklist-#{item.id}",
                          action: "submit->field-sync#submit input->field-sync#remember" } do |f| %>
              <%= f.label :response, for: "item-#{item.id}", class: "block text-sm font-medium text-ink-800" do %><%= item.label %><% if item.required %> <span class="text-rose-600" aria-label="obrigatório">*</span><% end %><% end %>
              <div class="flex gap-2">
                <% case item.response_kind %>
                <% when "check" %>
                  <%= f.select :response, [["Selecione", ""], ["Sim", "sim"], ["Não", "nao"]], { selected: item.response }, id: "item-#{item.id}", class: "sv-input", disabled: !@can_execute %>
                <% when "number" %>
                  <%= f.text_field :response, value: item.response, id: "item-#{item.id}", inputmode: "decimal", class: "sv-input", disabled: !@can_execute %>
                <% else %>
                  <%= f.text_field :response, value: item.response, id: "item-#{item.id}", class: "sv-input", disabled: !@can_execute %>
                <% end %>
                <% if @can_execute %><%= f.button "Salvar", type: "submit", class: "sv-btn-secondary shrink-0" %><% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="sv-card p-4" aria-labelledby="registro-title">
    <h2 id="registro-title" class="mb-2 font-semibold text-ink-900">Registro técnico</h2>
    <%= form_with url: field_operations_path, scope: :report, class: "space-y-3",
          data: { kind: "technical_report", version: @work_order.lock_version, draft_id: "technical-report",
                  action: "submit->field-sync#submit input->field-sync#remember" } do |f| %>
      <div><%= f.label :diagnosis, "Diagnóstico", class: "sv-label", for: "diagnostico" %><%= f.text_area :diagnosis, value: @work_order.diagnosis, id: "diagnostico", rows: 3, class: "sv-input", disabled: !@can_execute %></div>
      <div><%= f.label :solution, "Solução aplicada", class: "sv-label", for: "solucao" %><%= f.text_area :solution, value: @work_order.solution, id: "solucao", rows: 3, class: "sv-input", disabled: !@can_execute %></div>
      <% if @can_execute %><%= f.button "Salvar registro", type: "submit", class: "sv-btn-primary w-full py-3" %><% end %>
    <% end %>
  </section>

  <% if @can_execute %>
    <section class="sv-card p-4" aria-labelledby="apontamento-title">
      <h2 id="apontamento-title" class="mb-2 font-semibold text-ink-900">Apontar horas</h2>
      <%= form_with url: field_operations_path, scope: :time_entry, class: "space-y-3",
            data: { kind: "time_entry", draft_id: "time-entry", action: "submit->field-sync#submit input->field-sync#remember" } do |f| %>
        <div class="grid grid-cols-2 gap-3">
          <div><%= f.label :started_at, "Início", class: "sv-label", for: "inicio" %><%= f.datetime_local_field :started_at, id: "inicio", class: "sv-input", required: true %></div>
          <div><%= f.label :ended_at, "Término", class: "sv-label", for: "termino" %><%= f.datetime_local_field :ended_at, id: "termino", class: "sv-input", required: true %></div>
        </div>
        <div><%= f.label :notes, "Observação", class: "sv-label", for: "observacao" %><%= f.text_field :notes, id: "observacao", class: "sv-input" %></div>
        <%= f.button "Registrar horas", type: "submit", class: "sv-btn-secondary w-full py-3" %>
      <% end %>
      <% if @time_entries.any? %>
        <ul class="mt-3 space-y-1 text-sm text-ink-600" role="list">
          <% @time_entries.each do |entry| %>
            <li><%= l(entry.started_at.in_time_zone(zone), format: :short) %> · <%= entry.minutes %> min</li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>

  <p class="text-center text-sm"><%= link_to "Ver ordem completa", work_order_path(@work_order), class: "sv-link" %></p>
</div>

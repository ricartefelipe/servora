<% content_for :title, "Minha agenda" %>
<%= page_header("Minha agenda", subtitle: "Visitas dos próximos 7 dias e ordens atribuídas a você.") %>
<div data-controller="service-worker"></div>

<div class="space-y-6">
  <% (@today...(@today + Field::AgendaController::DAYS)).each do |day| %>
    <% visits = @visits_by_day.fetch(day, []) %>
    <% next if visits.empty? && day != @today %>
    <section aria-labelledby="dia-<%= day.iso8601 %>">
      <h2 id="dia-<%= day.iso8601 %>" class="mb-2 text-sm font-semibold uppercase tracking-wide text-ink-500">
        <%= day == @today ? "Hoje" : (day == @today + 1 ? "Amanhã" : l(day, format: "%A, %d/%m")) %>
      </h2>
      <% if visits.empty? %>
        <div class="sv-card px-5 py-6 text-sm text-ink-500">Nenhuma visita hoje.</div>
      <% else %>
        <ul class="space-y-3" role="list">
          <% visits.each do |visit| %>
            <% order = visit.work_order %>
            <li>
              <%= link_to field_work_order_path(order), class: "sv-card flex items-start gap-4 p-4 transition hover:border-brand-300 focus-visible:outline-2" do %>
                <div class="sv-num w-16 shrink-0 text-center">
                  <p class="text-lg font-bold text-ink-950"><%= l(visit.scheduled_start.in_time_zone(current_organization.zone), format: "%H:%M") %></p>
                  <p class="text-xs text-ink-500">até <%= l(visit.scheduled_end.in_time_zone(current_organization.zone), format: "%H:%M") %></p>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-ink-900"><%= order.title %></p>
                  <p class="text-sm text-ink-600"><%= order.customer.display_name %></p>
                  <p class="truncate text-xs text-ink-500"><%= order.service_location.address_line %></p>
                </div>
                <%= badge(visit.status == "in_progress" ? "Em andamento" : order.number, tone: visit.status == "in_progress" ? :warning : :neutral, dot: false) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>

  <% if @unscheduled.any? %>
    <section aria-labelledby="sem-visita-title">
      <h2 id="sem-visita-title" class="mb-2 text-sm font-semibold uppercase tracking-wide text-ink-500">Atribuídas sem visita marcada</h2>
      <ul class="sv-card divide-y divide-ink-100" role="list">
        <% @unscheduled.each do |order| %>
          <li><%= link_to field_work_order_path(order), class: "flex items-center gap-3 px-4 py-3 hover:bg-ink-50" do %>
            <span class="min-w-0 flex-1"><span class="block font-medium text-ink-900"><%= order.title %></span><span class="text-xs text-ink-500"><%= order.customer.display_name %></span></span>
            <span class="font-mono text-xs text-ink-500"><%= order.number %></span>
          <% end %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

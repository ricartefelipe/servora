<%# A visit in the technician's list: the card opens the work order; Ligar and Rota are 44px secondary actions. %>
<% order = visit.work_order %>
<% customer = order.customer %>
<% location = order.service_location %>
<% phone = customer.phone.to_s.gsub(/[^\d+]/, "") %>
<% route_url = "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode([location.address_line, location.city_line].join(', '))}" %>
<article class="overflow-hidden rounded-2xl bg-white ring-1 ring-ink-200">
  <%= link_to field_work_order_path(order), class: "block rounded-t-2xl p-4 transition-colors duration-150 hover:bg-ink-25 focus-visible:-outline-offset-2" do %>
    <span class="flex items-start justify-between gap-3">
      <span class="font-mono text-xl font-semibold leading-7 tracking-tight text-ink-950">
        <%= l(visit.scheduled_start.in_time_zone(zone), format: "%H:%M") %><span class="text-ink-500"> – <%= l(visit.scheduled_end.in_time_zone(zone), format: "%H:%M") %></span>
      </span>
      <%= badge(visit.status_label, tone: visit.status == "in_progress" ? :ember : :indigo) %>
    </span>
    <span class="mt-2 block text-base font-semibold text-ink-950"><%= customer.display_name %></span>
    <span class="block text-[15px] text-ink-800"><%= order.title %></span>
    <span class="mt-1 block truncate text-sm text-ink-600"><%= location.address_line %></span>
    <span class="mt-1 block font-mono text-[13px] text-ink-500"><%= order.number %></span>
  <% end %>
  <div class="grid grid-cols-2 gap-2 border-t border-ink-150 p-3">
    <% if phone.present? %>
      <%= link_to "tel:#{phone}", class: "sv-btn-secondary h-11 text-sm" do %>
        <%= icon(:phone, size: 18) %> Ligar<span class="sr-only"> para <%= customer.display_name %></span>
      <% end %>
    <% end %>
    <%= link_to route_url, class: phone.present? ? "sv-btn-secondary h-11 text-sm" : "sv-btn-secondary col-span-2 h-11 text-sm",
          target: "_blank", rel: "noopener noreferrer" do %>
      <%= icon(:pin, size: 18) %> Rota<span class="sr-only"> até <%= location.address_line %> (abre em nova aba)</span>
    <% end %>
  </div>
</article>

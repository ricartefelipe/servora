<% content_for :title, "Agenda" %>
<% step = @agenda.week? ? 7 : 1 %>
<%= page_header("Agenda", subtitle: @agenda.week? ? "Semana de #{l(@agenda.days.first)} a #{l(@agenda.days.last)}" : l(@date, format: :long)) do %>
  <nav class="flex items-center gap-1" aria-label="Navegar na agenda">
    <%= link_to agenda_index_path(data: (@date - step).iso8601, visao: @mode, tecnico: params[:tecnico]), class: "sv-btn-secondary sv-btn-sm", aria: { label: "Período anterior" } do %><%= icon(:chevron_right, size: 16, css: "rotate-180") %><% end %>
    <%= link_to "Hoje", agenda_index_path(visao: @mode, tecnico: params[:tecnico]), class: "sv-btn-secondary sv-btn-sm" %>
    <%= link_to agenda_index_path(data: (@date + step).iso8601, visao: @mode, tecnico: params[:tecnico]), class: "sv-btn-secondary sv-btn-sm", aria: { label: "Próximo período" } do %><%= icon(:chevron_right, size: 16) %><% end %>
  </nav>
  <div class="flex rounded-xl border border-ink-200 bg-white p-0.5" role="group" aria-label="Visão">
    <% [["dia", "Dia"], ["semana", "Semana"]].each do |value, label| %>
      <%= link_to label, agenda_index_path(data: @date.iso8601, visao: value, tecnico: params[:tecnico]),
            class: "rounded-lg px-3 py-1.5 text-sm font-medium #{@mode == value ? 'bg-brand-600 text-white' : 'text-ink-600 hover:bg-ink-50'}",
            aria: { current: (@mode == value ? "page" : nil) } %>
    <% end %>
  </div>
  <% if policy(TechnicianAllocation).create? %><%= link_to "Ausências", absences_path, class: "sv-btn-secondary sv-btn-sm" %><% end %>
<% end %>

<% if @agenda.rows.empty? %>
  <section class="sv-card"><%= empty_state("Nenhum técnico cadastrado", description: "Convide técnicos e defina seus horários de trabalho.", icon_name: :calendar) %></section>
<% elsif @agenda.week? %>
  <section class="sv-card relative overflow-x-auto">
    <table class="sv-table">
      <thead>
        <tr>
          <th scope="col">Técnico</th>
          <% @agenda.days.each do |day| %>
            <th scope="col" class="<%= 'text-brand-700' if day == Time.zone.today %>"><%= l(day, format: "%a %d/%m") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-100">
        <% @agenda.rows.each do |row| %>
          <tr>
            <th scope="row" class="whitespace-nowrap px-4 py-3 text-left font-medium text-ink-900"><%= row.membership.user.name %></th>
            <% @agenda.days.each do |day| %>
              <td class="min-w-36 align-top">
                <% @agenda.allocations_on(row, day).each do |allocation| %>
                  <%= render "agenda/allocation_chip", allocation: %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <section class="sv-card relative overflow-x-auto p-4" aria-label="Linha do tempo do dia">
    <div class="min-w-[960px]">
      <div class="ml-44 grid grid-cols-16 border-b border-ink-100 pb-1 text-[11px] font-medium text-ink-400" aria-hidden="true">
        <% (Scheduling::AgendaQuery::DAY_START_HOUR...Scheduling::AgendaQuery::DAY_END_HOUR).each do |hour| %>
          <span><%= format("%02d:00", hour) %></span>
        <% end %>
      </div>
      <ul class="divide-y divide-ink-100" role="list">
        <% @agenda.rows.each do |row| %>
          <li class="flex items-stretch gap-3 py-2">
            <div class="w-41 shrink-0 pt-1">
              <p class="truncate text-sm font-semibold text-ink-900"><%= row.membership.user.name %></p>
              <p class="text-xs text-ink-500"><%= pluralize(@agenda.allocations_on(row, @date).count { |a| a.kind == "visit" }, "visita") %></p>
            </div>
            <div class="relative grid min-h-14 flex-1 grid-cols-[repeat(64,minmax(0,1fr))] rounded-xl bg-[linear-gradient(to_right,var(--color-ink-100)_1px,transparent_1px)] bg-[length:6.25%_100%]">
              <% @agenda.blocks_for(row, @date).each do |block| %>
                <% if block.absence? %>
                  <div class="col-start-<%= block.column_start %> col-span-<%= block.column_span %> row-start-1 m-0.5 flex items-center overflow-hidden rounded-lg bg-[repeating-linear-gradient(45deg,var(--color-ink-100),var(--color-ink-100)_6px,var(--color-ink-200)_6px,var(--color-ink-200)_12px)] px-2 text-xs font-medium text-ink-600"
                       title="Ausência: <%= block.allocation.reason %>">
                    Ausência
                  </div>
                <% else %>
                  <% visit = block.visit %>
                  <%= link_to work_order_path(visit.work_order),
                        class: "col-start-#{block.column_start} col-span-#{block.column_span} row-start-1 m-0.5 flex min-w-0 flex-col justify-center overflow-hidden rounded-lg border-l-4 px-2 py-1 text-xs transition hover:brightness-95 focus-visible:outline-2 #{visit.in_progress? ? 'border-ember-500 bg-ember-50 text-ember-600' : visit.completed? ? 'border-emerald-500 bg-emerald-50 text-emerald-800' : 'border-brand-600 bg-brand-50 text-brand-800'}",
                        aria: { label: "#{visit.work_order.number}, #{l(visit.scheduled_start, format: '%H:%M')} às #{l(visit.scheduled_end, format: '%H:%M')}, #{visit.work_order.customer.display_name}, #{visit.status_label}" } do %>
                    <span class="truncate font-semibold"><%= visit.work_order.number %></span>
                    <span class="truncate"><%= l(visit.scheduled_start, format: "%H:%M") %>–<%= l(visit.scheduled_end, format: "%H:%M") %> · <%= visit.work_order.customer.display_name %></span>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
  <p class="mt-3 text-xs text-ink-500">Blocos incluem o intervalo de deslocamento após a visita. Para reagendar, abra a ordem de serviço.</p>
<% end %>

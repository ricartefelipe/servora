<% content_for :title, "Perfil do técnico" %>
<%= page_header(@technician.user.name, eyebrow: "Técnico", subtitle: "Competências e horário semanal de trabalho.") %>
<%= form_with url: technician_path(@technician), method: :patch, scope: :technician, class: "max-w-3xl space-y-6" do |f| %>
  <section class="sv-card p-6">
    <h2 class="mb-3 font-semibold text-ink-900">Competências</h2>
    <div class="grid gap-2 sm:grid-cols-2">
      <% @skills.each do |skill| %>
        <label class="flex items-center gap-2 text-sm"><%= check_box_tag "technician[skill_ids][]", skill.id, @technician.skills.include?(skill), id: "skill_#{skill.id}", class: "rounded border-ink-300 text-brand-600" %><%= skill.name %></label>
      <% end %>
    </div>
    <div class="mt-4 max-w-sm"><%= f.label :new_skill, "Nova competência", class: "sv-label" %><%= f.text_field :new_skill, class: "sv-input", placeholder: "Ex.: Refrigeração comercial" %></div>
  </section>
  <section class="sv-card p-6">
    <h2 class="mb-1 font-semibold text-ink-900">Horário de trabalho</h2>
    <p class="mb-4 text-sm text-ink-500">Até dois turnos por dia (ex.: 08:00–12:00 e 13:00–18:00). Deixe em branco nos dias sem expediente.</p>
    <div class="space-y-2">
      <% WorkSchedule::WEEKDAYS.each_with_index do |label, weekday| %>
        <% shifts = @technician.work_schedules.select { |s| s.weekday == weekday } %>
        <div class="grid grid-cols-[6rem_repeat(4,minmax(0,1fr))] items-center gap-2 text-sm">
          <span class="font-medium text-ink-700"><%= label %></span>
          <% 2.times do |shift| %>
            <% schedule = shifts[shift] %>
            <% index = (weekday * 2) + shift %>
            <%= hidden_field_tag "technician[schedules][#{index}][weekday]", weekday %>
            <%= time_field_tag "technician[schedules][#{index}][start]", schedule && format("%02d:%02d", schedule.start_minute / 60, schedule.start_minute % 60), class: "sv-input py-1.5", aria: { label: "#{label}, turno #{shift + 1}, início" } %>
            <%= time_field_tag "technician[schedules][#{index}][end]", schedule && format("%02d:%02d", schedule.end_minute / 60, schedule.end_minute % 60), class: "sv-input py-1.5", aria: { label: "#{label}, turno #{shift + 1}, término" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
  <div class="flex gap-3">
    <%= f.button "Salvar perfil", type: "submit", class: "sv-btn-primary" %>
    <%= link_to "Cancelar", technicians_path, class: "sv-btn-secondary" %>
  </div>
<% end %>

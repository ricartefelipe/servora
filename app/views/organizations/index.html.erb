<% content_for :title, "Organizações" %>
<% content_for :container_width, "max-w-lg" %>
<%= render "shared/auth_heading", title: "Escolha a organização", subtitle: "Você participa das organizações abaixo. Os dados de cada uma ficam isolados." %>

<ul class="space-y-3" role="list">
  <% @memberships.each do |membership| %>
    <li>
      <%= button_to select_organization_path(membership.organization), method: :post,
            class: "group flex w-full items-center gap-4 rounded-xl bg-white p-4 text-left ring-1 ring-ink-200 transition-colors duration-150 hover:bg-ink-25 hover:ring-ink-300" do %>
        <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-white text-xs font-semibold text-ink-800 ring-1 ring-inset ring-ink-200" aria-hidden="true">
          <%= membership.organization.name.split.first(2).pluck(0).join.upcase %>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-[15px] font-semibold text-ink-950"><%= membership.organization.name %></span>
          <span class="block text-[13px] text-ink-500"><%= membership.role_label %></span>
        </span>
        <%= icon(:chevron_right, size: 18, css: "text-ink-400 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-ink-800") %>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-ink-150 pt-6">
  <%= link_to new_organization_path, class: "sv-btn-secondary" do %><%= icon(:plus, size: 18) %> Cadastrar nova organização<% end %>
  <%= button_to destroy_user_session_path, method: :delete, class: "sv-btn-ghost", form: { data: { turbo: false } } do %><%= icon(:logout, size: 16) %> Sair<% end %>
</div>

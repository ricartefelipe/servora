<% content_for :title, "Organizações" %>
<% content_for :container_width, "max-w-lg" %>
<%= render "shared/auth_heading", title: "Escolha a organização", subtitle: "Você participa das organizações abaixo. Os dados de cada uma ficam isolados." %>

<ul class="space-y-3" role="list">
  <% @memberships.each do |membership| %>
    <li>
      <%= button_to select_organization_path(membership.organization), method: :post,
            class: "group flex w-full items-center gap-4 rounded-2xl border border-ink-200 bg-white p-4 text-left transition hover:border-brand-300 hover:shadow-[var(--shadow-card)]" do %>
        <span class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-700"><%= icon(:building) %></span>
        <span class="min-w-0 flex-1">
          <span class="block truncate font-semibold text-ink-900"><%= membership.organization.name %></span>
          <span class="block text-sm text-ink-500"><%= membership.role_label %></span>
        </span>
        <%= icon(:chevron_right, css: "text-ink-300 group-hover:text-brand-600") %>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-ink-100 pt-6">
  <%= link_to new_organization_path, class: "sv-btn-secondary" do %><%= icon(:plus, size: 18) %> Cadastrar nova organização<% end %>
  <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "sv-btn-ghost", form: { data: { turbo: false } } %>
</div>

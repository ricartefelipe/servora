<% content_for :title, @error.title %>
<%# Inside the app layout (signed-in member) the shell already shows the logo and the brand rule. %>
<% in_app = respond_to?(:current_membership) && current_membership.present? %>
<% unless in_app %><%= render "shared/brand_rule" %><% end %>
<div class="flex <%= in_app ? 'min-h-[calc(100vh-10rem)]' : 'min-h-screen bg-ink-25' %> items-center justify-center px-6">
  <div class="w-full max-w-md text-center animate-slide-up">
    <% unless in_app %><div class="mb-10 flex justify-center"><%= render "shared/logo" %></div><% end %>
    <p class="sv-eyebrow justify-center"><span class="sv-facet" aria-hidden="true"></span>Erro <span class="sv-num"><%= @error.code %></span></p>
    <h1 class="sv-display mt-3 text-display-lg text-ink-950"><%= @error.title %></h1>
    <p class="mx-auto mt-3 max-w-md text-balance text-[15px] leading-relaxed text-ink-600"><%= @error.message %></p>
    <div class="mt-8 flex justify-center gap-3">
      <%= link_to "Voltar ao início", root_path, class: "sv-btn-primary" %>
    </div>
  </div>
</div>

<% content_for :title, "Gestão de serviços de campo" %>
<div class="relative isolate min-h-dvh overflow-hidden bg-ink-950">
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-60" aria-hidden="true">
    <div class="absolute -left-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-brand-600/30 blur-3xl"></div>
    <div class="absolute -bottom-48 right-0 h-[28rem] w-[28rem] rounded-full bg-ember-500/20 blur-3xl"></div>
  </div>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
    <%= render "shared/logo", tone: :light %>
    <nav aria-label="Acesso" class="flex items-center gap-2 sm:gap-3">
      <% if user_signed_in? %>
        <%= link_to "Abrir o painel", dashboard_path, class: "sv-btn-primary" %>
      <% else %>
        <%= link_to "Entrar", new_user_session_path, class: "sv-btn text-white hover:bg-white/10 focus-visible:outline-white" %>
        <%= link_to "Criar conta", new_user_registration_path, class: "sv-btn-primary" %>
      <% end %>
    </nav>
  </header>
  <section class="mx-auto grid max-w-6xl gap-12 px-6 pb-24 pt-10 lg:grid-cols-2 lg:pt-20">
    <div class="animate-slide-up">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-300 ring-1 ring-white/10">
        Operação de campo com rastreabilidade
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Da solicitação do cliente ao resultado de cada serviço.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
        O Servora organiza orçamentos, ordens de serviço, agenda das equipes, peças, contratos e recebimentos
        de empresas de climatização, manutenção predial e assistência técnica — sem planilhas paralelas.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <% if user_signed_in? %>
          <%= link_to "Continuar no painel", dashboard_path, class: "sv-btn-primary px-5 py-3 text-base" %>
        <% else %>
          <%= link_to "Começar agora", new_user_registration_path, class: "sv-btn-primary px-5 py-3 text-base" %>
          <%= link_to "Já tenho conta", new_user_session_path,
                class: "sv-btn px-5 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/10 focus-visible:outline-white" %>
        <% end %>
      </div>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      <% [
        ["Orçamentos versionados", "Aprovação registrada pela versão aceita, com histórico de negociação."],
        ["Agenda sem conflitos", "Reservas de técnicos e equipes protegidas pelo banco de dados."],
        ["Estoque rastreável", "Saldo físico, reservado e disponível com custo médio histórico."],
        ["Margem real por ordem", "Materiais, mão de obra e despesas comparados ao faturamento."]
      ].each do |title, text| %>
        <li class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10 backdrop-blur">
          <p class="font-semibold text-white"><%= title %></p>
          <p class="mt-2 text-sm leading-relaxed text-ink-300"><%= text %></p>
        </li>
      <% end %>
    </ul>
  </section>
</div>

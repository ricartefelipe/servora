<%# Shared header of the inventory area: title, operations and section links. %>
<% stock_policy = policy(StockBalance) %>
<%= page_header("Estoque", subtitle: "Saldo físico, reservado e disponível por depósito. Toda alteração gera uma movimentação rastreável.") do %>
  <% if stock_policy.adjust? %>
    <%= link_to new_stock_adjustment_path(deposito: @warehouse&.id), class: "sv-btn-ghost", data: { turbo_frame: "modal" } do %><%= icon(:audit, size: 18) %> Ajuste<% end %>
  <% end %>
  <% if stock_policy.transfer? %>
    <%= link_to new_stock_transfer_path(deposito: @warehouse&.id), class: "sv-btn-secondary", data: { turbo_frame: "modal" } do %><%= icon(:switch, size: 18) %> Transferência<% end %>
  <% end %>
  <% if stock_policy.receive? %>
    <%= link_to new_stock_receipt_path(deposito: @warehouse&.id), class: "sv-btn-primary", data: { turbo_frame: "modal" } do %><%= icon(:plus, size: 18) %> Entrada<% end %>
  <% end %>
<% end %>

<nav class="mb-5 flex gap-1 overflow-x-auto border-b border-ink-200" aria-label="Seções do estoque">
  <% [["Saldos", stock_balances_path, "stock_balances"], ["Movimentações", stock_movements_path, "stock_movements"],
      ["Depósitos", warehouses_path, "warehouses"]].each do |label, path, section| %>
    <% current = controller_name == section %>
    <%= link_to label, path, aria: { current: (current ? "page" : nil) },
          class: "-mb-px whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-medium #{current ? 'border-brand-600 text-brand-700' : 'border-transparent text-ink-500 hover:text-ink-800'}" %>
  <% end %>
</nav>

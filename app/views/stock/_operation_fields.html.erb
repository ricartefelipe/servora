<%# Fields shared by every stock operation form. %>
<%= f.hidden_field :operation_key %>
<% if items.empty? %>
  <div class="flex items-start gap-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-600/20" role="status">
    <%= icon(:alert, size: 16, css: "mt-0.5 text-amber-700") %>
    <span>Nenhuma peça controla estoque. Marque “Controla estoque” no cadastro da peça no catálogo.</span>
  </div>
<% end %>
<div class="grid gap-5 sm:grid-cols-2">
  <%= f.select_field :warehouse_id, warehouses.map { |w| [w.name, w.id] }, label: warehouse_label, include_blank: "Selecione", required: true %>
  <%= f.select_field :catalog_item_id, items.map { |i| [[i.name, i.sku].compact.join(" · "), i.id] }, label: "Peça",
        include_blank: "Selecione", required: true %>
</div>

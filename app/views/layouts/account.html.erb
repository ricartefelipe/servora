<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-white">
  <head>
    <title><%= [content_for(:title), "Servora"].compact_blank.join(" · ") %></title>
    <%= render "layouts/head" %>
  </head>
  <body class="h-full bg-white" data-controller="local-context" data-local-context-key-value="<%= local_context_key %>">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 sv-btn-primary">Ir para o conteúdo</a>
    <div id="flash"><%= render "shared/flash" %></div>
    <%# Wide account pages (security, organizations) only show the showcase when there is room for both columns. %>
    <% wide = content_for?(:container_width) %>
    <div class="grid min-h-full <%= wide ? "2xl:grid-cols-2" : "lg:grid-cols-2" %>">
      <main id="conteudo" class="flex min-h-full flex-col bg-white px-6 py-6 sm:px-12 lg:px-16">
        <header>
          <%= link_to root_path, class: "inline-flex rounded-xl", aria: { label: "Servora, acesso" } do %>
            <%= render "shared/logo" %>
          <% end %>
        </header>
        <div class="flex flex-1 items-center py-12">
          <div class="mx-auto w-full <%= content_for(:container_width).presence || "max-w-sm" %> animate-slide-up">
            <%= yield %>
          </div>
        </div>
        <footer class="flex flex-wrap items-center justify-between gap-2 text-xs text-ink-500">
          <span>Servora · gestão de serviços de campo</span>
          <span class="font-mono">v<%= Servora::VERSION %></span>
        </footer>
      </main>

      <aside class="relative hidden p-3 <%= wide ? "2xl:block" : "lg:block" %>" aria-hidden="true">
        <div class="relative isolate flex h-full flex-col justify-between overflow-hidden rounded-[1.75rem] bg-ink-950 p-10 xl:p-14">
          <svg class="absolute inset-0 -z-10 size-full" aria-hidden="true" focusable="false">
            <defs>
              <pattern id="showcase-grid" width="44" height="44" patternUnits="userSpaceOnUse">
                <path d="M44 0H0V44" fill="none" stroke="#ffffff" stroke-opacity="0.05"/>
              </pattern>
              <radialGradient id="showcase-fade" cx="50%" cy="42%" r="65%">
                <stop offset="0" stop-color="#ffffff"/>
                <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
              </radialGradient>
              <mask id="showcase-mask"><rect width="100%" height="100%" fill="url(#showcase-fade)"/></mask>
            </defs>
            <rect width="100%" height="100%" fill="url(#showcase-grid)" mask="url(#showcase-mask)"/>
          </svg>
          <div class="pointer-events-none absolute left-1/2 top-[38%] -z-10 size-[30rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-600/25 blur-3xl"></div>

          <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-300">Gestão de serviços de campo</p>

          <%= render "shared/gem", class: "mx-auto w-full max-w-sm drop-shadow-2xl" %>

          <div>
            <p class="text-4xl font-semibold leading-[1.1] tracking-tight text-white xl:text-5xl">
              Operação de campo,<br><span class="text-brand-400">lapidada.</span>
            </p>
            <p class="mt-5 max-w-md text-sm leading-relaxed text-ink-300">
              Orçamentos, ordens de serviço, agenda, estoque e recebimentos com rastreabilidade de ponta a ponta —
              da solicitação do cliente à margem de cada serviço.
            </p>
            <ul class="mt-8 flex flex-wrap gap-2" role="list">
              <% %w[Orçamentos Ordens\ de\ serviço Agenda Estoque Contratos Financeiro].each do |item| %>
                <li class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-ink-200 ring-1 ring-inset ring-white/10"><%= item %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </body>
</html>

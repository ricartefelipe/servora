<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-ink-25">
  <head>
    <title><%= [content_for(:title), current_organization&.name, "Servora"].compact_blank.join(" · ") %></title>
    <%= render "layouts/head" %>
  </head>
  <body class="h-full" data-controller="shell local-context command-palette density" data-local-context-key-value="<%= local_context_key %>"
        data-command-palette-url-value="<%= search_path %>"
        data-action="keydown.esc@window->shell#close keydown.ctrl+k@window->command-palette#open keydown.meta+k@window->command-palette#open turbo:before-cache@document->command-palette#dismiss">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 sv-btn-primary">Ir para o conteúdo</a>
    <%= render "shared/brand_rule" %>
    <div id="flash"><%= render "shared/flash" %></div>

    <div class="fixed inset-0 z-30 bg-ink-950/40 lg:hidden" data-shell-target="overlay" data-action="click->shell#close" hidden></div>
    <%= render "layouts/sidebar" %>

    <div class="flex min-h-full flex-col lg:pl-64">
      <header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-ink-200 bg-ink-25/85 px-4 backdrop-blur-sm sm:px-6 xl:px-8">
        <button type="button" class="sv-btn-ghost -ml-2 size-9 p-0 lg:hidden" data-action="shell#open" data-shell-target="toggle"
                aria-controls="navegacao" aria-expanded="false" aria-label="Abrir navegação">
          <%= icon(:menu) %>
        </button>
        <p class="truncate text-[13px] font-semibold text-ink-900 lg:hidden"><%= current_organization.name %></p>
        <% section, entry = breadcrumb_trail %>
        <% if entry %>
          <nav aria-label="Trilha" class="hidden min-w-0 lg:block">
            <ol class="flex items-center gap-1.5 text-[13px]" role="list">
              <li class="text-ink-500"><%= section %></li>
              <li aria-hidden="true"><%= icon(:chevron_right, size: 14, css: "text-ink-300") %></li>
              <li class="min-w-0"><%= link_to entry.label, public_send(entry.route), class: "truncate font-medium text-ink-950 hover:underline hover:decoration-ink-300 hover:underline-offset-4", aria: { current: "location" } %></li>
            </ol>
          </nav>
        <% end %>
        <div class="ml-auto flex items-center gap-1.5">
          <button type="button" data-action="command-palette#open" aria-haspopup="dialog" aria-controls="busca-rapida"
                  aria-keyshortcuts="Control+K Meta+K" aria-label="Buscar"
                  class="grid size-9 place-items-center rounded-lg text-ink-600 transition-colors hover:bg-ink-950/[0.04] hover:text-ink-950 sm:mr-1.5 sm:flex sm:h-9 sm:w-64 sm:items-center sm:gap-2 sm:bg-white sm:px-2.5 sm:text-ink-500 sm:shadow-[var(--shadow-xs)] sm:ring-1 sm:ring-inset sm:ring-ink-200 sm:hover:bg-white sm:hover:text-ink-700 sm:hover:ring-ink-300">
            <%= icon(:search, size: 18) %>
            <span class="hidden flex-1 text-left text-[13px] sm:block">Buscar…</span>
            <kbd class="sv-kbd hidden sm:inline" aria-hidden="true" data-command-palette-target="shortcut">Ctrl K</kbd>
          </button>
          <%= turbo_stream_from current_membership, :notifications, channel: NotificationsChannel %>
          <%= link_to notifications_path, class: "relative grid size-9 place-items-center rounded-lg text-ink-600 hover:bg-ink-950/[0.04] hover:text-ink-950", aria: { label: "Notificações" } do %>
            <%= icon(:bell, size: 18) %>
            <%= render "notifications/counter", unread: current_organization.notifications.for_recipient(current_membership).unread.count %>
          <% end %>
          <details class="relative" data-controller="disclosure">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-1.5 py-1 hover:bg-ink-950/[0.04]" aria-label="Menu da conta">
              <%= avatar(current_user.name) %>
              <span class="hidden text-left sm:block">
                <span class="block text-[13px] font-semibold leading-tight text-ink-950"><%= current_user.name %></span>
                <span class="block text-[11px] leading-tight text-ink-500"><%= current_membership.role_label %></span>
              </span>
              <%= icon(:chevron_down, size: 16, css: "text-ink-400") %>
            </summary>
            <div class="absolute right-0 mt-2 w-60 rounded-xl bg-white p-1.5 shadow-[var(--shadow-float)] animate-fade-in">
              <%= link_to account_security_path, class: "flex items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] text-ink-800 hover:bg-ink-50" do %>
                <%= icon(:key, size: 18) %> Segurança da conta
              <% end %>
              <%= link_to organizations_path, class: "flex items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] text-ink-800 hover:bg-ink-50" do %>
                <%= icon(:switch, size: 18) %> Trocar organização
              <% end %>
              <%= button_to destroy_user_session_path, method: :delete, form: { data: { turbo: false } },
                    class: "flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-left text-[13px] text-ink-800 hover:bg-ink-50" do %>
                <%= icon(:logout, size: 18) %> Sair
              <% end %>
              <p class="mt-1 border-t border-ink-150 px-2.5 pb-1 pt-2 font-mono text-[11px] text-ink-500">Servora <%= Servora::VERSION %></p>
            </div>
          </details>
        </div>
      </header>

      <%= render "layouts/mfa_banner" %>

      <main id="conteudo" class="mx-auto w-full max-w-[1440px] flex-1 px-4 py-6 sm:px-6 xl:px-8" tabindex="-1">
        <%= yield %>
      </main>
      <%= turbo_frame_tag "modal" %>
    </div>
    <%= render "shared/command_palette" %>
  </body>
</html>

<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-ink-50">
  <head>
    <title><%= [content_for(:title), "Portal do cliente"].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-full">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 sv-btn-primary">Ir para o conteúdo</a>
    <div id="flash"><%= render "shared/flash" %></div>
    <header class="border-b border-ink-200 bg-white">
      <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-5 py-4">
        <div class="flex items-center gap-3">
          <%= render "shared/logo", mark_only: true, size: 30 %>
          <div>
            <p class="text-sm font-semibold leading-tight text-ink-900"><%= current_portal_organization&.name || "Portal do cliente" %></p>
            <p class="text-xs leading-tight text-ink-500">Portal do cliente</p>
          </div>
        </div>
        <% if current_contact %>
          <nav aria-label="Portal" class="flex items-center gap-1 text-sm">
            <%= link_to "Início", portal_root_path, class: "sv-btn-ghost sv-btn-sm" %>
            <%= link_to "Orçamentos", portal_quotes_path, class: "sv-btn-ghost sv-btn-sm" %>
            <%= button_to "Sair", portal_sign_out_path, method: :delete, class: "sv-btn-ghost sv-btn-sm text-rose-700" %>
          </nav>
        <% end %>
      </div>
    </header>
    <main id="conteudo" class="mx-auto max-w-4xl px-5 py-8">
      <%= yield %>
    </main>
    <footer class="mx-auto max-w-4xl px-5 pb-10 text-xs text-ink-400">Ambiente seguro operado com Servora.</footer>
  </body>
</html>

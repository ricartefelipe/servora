<!DOCTYPE html>
<%# Technician shell (/campo): light and sunlight-safe. A white top bar with the gem and the page title, the
    content in a single column and a fixed bottom tab bar. No sidebar, no blur. %>
<% content_for :theme_color, "#ffffff" unless content_for?(:theme_color) %>
<% on_agenda = controller_path == "field/agenda" %>
<% tab_base = "relative flex h-full w-full flex-col items-center justify-center gap-1 text-[11px] transition-colors duration-150 focus-visible:-outline-offset-2" %>
<% tab_idle = "#{tab_base} font-medium text-ink-500 hover:text-ink-800" %>
<% tab_active = "#{tab_base} font-semibold text-ink-950" %>
<html lang="pt-BR" class="h-full bg-ink-25">
  <head>
    <title><%= [content_for(:title), current_organization&.name, "Servora"].compact_blank.join(" · ") %></title>
    <%= render "layouts/head" %>
  </head>
  <body class="min-h-full text-base" data-controller="local-context" data-local-context-key-value="<%= local_context_key %>">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 sv-btn-primary">Ir para o conteúdo</a>
    <%= render "shared/brand_rule" %>
    <%# Toasts sit under the top bar, clear of the sticky visit actions and the tab bar. %>
    <div id="flash" class="[&>div]:top-[calc(3.5rem+0.5rem)] [&>div]:bottom-auto"><%= render "shared/flash" %></div>

    <header class="sticky top-0 z-20 border-b border-ink-200 bg-white">
      <div class="mx-auto flex h-14 max-w-2xl items-center gap-3 px-4">
        <%= render "shared/logo", size: 24, mark_only: true %>
        <p class="min-w-0 flex-1 truncate text-[17px] font-semibold text-ink-950"><%= content_for(:field_title).presence || content_for(:title) %></p>
        <p class="hidden max-w-[40%] truncate text-[13px] text-ink-500 sm:block"><%= current_organization.name %></p>
        <%# Sync chip: every variant stays hidden until field-status knows the real state of the device queue. %>
        <div class="flex shrink-0 items-center gap-2" data-controller="field-status"
             data-field-status-url-value="<%= field_operations_path %>" data-field-status-context-key-value="<%= local_context_key %>">
          <p role="status" aria-live="polite" tabindex="-1" class="flex rounded-md" data-field-status-target="region">
            <span class="sr-only">Sincronização: </span>
            <span data-field-status-target="variant" data-state="synced" hidden
                  class="inline-flex h-7 items-center gap-1.5 rounded-md bg-emerald-50 px-2 text-[13px] font-medium text-emerald-800 ring-1 ring-inset ring-emerald-600/20">
              <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>Sincronizado
            </span>
            <span data-field-status-target="variant" data-state="pending" hidden
                  class="inline-flex h-7 items-center gap-1.5 rounded-md bg-ink-50 px-2 text-[13px] font-medium text-ink-700 ring-1 ring-inset ring-ink-950/10">
              <%= icon(:switch, size: 14, css: "text-ink-500") %><span data-field-status-target="pendingText">Sincronizando</span>
            </span>
            <span data-field-status-target="variant" data-state="offline" hidden
                  class="inline-flex h-7 items-center gap-1.5 rounded-md bg-amber-50 px-2 text-[13px] font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">
              <%# cloud-off %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
                   stroke-linejoin="round" class="shrink-0 text-amber-700" aria-hidden="true" focusable="false">
                <path d="M3 3l18 18"/><path d="M6.2 6.3A6 6 0 0 0 7 18h10.5c.5 0 1-.1 1.4-.2"/><path d="M21 15.8A4 4 0 0 0 17.5 9h-1.2A6 6 0 0 0 10.4 6"/>
              </svg>
              <span data-field-status-target="offlineText">Offline</span>
            </span>
            <span data-field-status-target="variant" data-state="error" hidden
                  class="inline-flex h-7 items-center gap-1.5 rounded-md bg-rose-50 px-2 text-[13px] font-medium text-rose-800 ring-1 ring-inset ring-rose-600/20">
              <%= icon(:alert, size: 14, css: "text-rose-600") %>Falha ao sincronizar
            </span>
          </p>
          <button type="button" class="sv-btn-secondary h-11 px-3 text-[13px]" data-field-status-target="retry"
                  data-action="field-status#retry" hidden>Tentar</button>
        </div>
      </div>
    </header>

    <%= render "layouts/mfa_banner" %>

    <%# Bottom padding keeps the last block clear of the fixed tab bar (4rem + safe area). %>
    <main id="conteudo" class="mx-auto w-full max-w-2xl px-4 pt-5 pb-[calc(6rem+env(safe-area-inset-bottom))]" tabindex="-1">
      <%= yield %>
    </main>
    <%= turbo_frame_tag "modal" %>

    <nav aria-label="Navegação principal" class="fixed inset-x-0 bottom-0 z-30 border-t border-ink-200 bg-white pb-[env(safe-area-inset-bottom)]">
      <ul class="mx-auto flex h-16 max-w-2xl" role="list">
        <li class="flex-1">
          <%= link_to field_root_path, class: tab_active, aria: { current: on_agenda ? "page" : "true" } do %>
            <span class="absolute inset-x-4 top-0 h-0.5 rounded-b-full bg-brand-600 forced-colors:bg-[Highlight]" aria-hidden="true"></span>
            <%= icon(:calendar, size: 22, css: "text-brand-600") %>
            Hoje
          <% end %>
        </li>
        <% if can?(:work_orders_view_all) || can?(:work_orders_execute) %>
          <li class="flex-1">
            <%= link_to work_orders_path, class: tab_idle do %>
              <%= icon(:orders, size: 22) %>
              Ordens
            <% end %>
          </li>
        <% end %>
        <li class="flex-1">
          <%= link_to account_security_path, class: tab_idle do %>
            <%= icon(:team, size: 22) %>
            Perfil
          <% end %>
        </li>
        <li class="flex-1">
          <%= button_to destroy_user_session_path, method: :delete, form: { class: "h-full", data: { turbo: false } },
                class: "#{tab_idle} cursor-pointer" do %>
            <%= icon(:logout, size: 22) %>
            Sair
          <% end %>
        </li>
      </ul>
    </nav>
  </body>
</html>

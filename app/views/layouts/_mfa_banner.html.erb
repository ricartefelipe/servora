<% requirement = Authentication::MfaRequirement.new(membership: current_membership, user: current_user) %>
<% if requirement.pending? %>
  <div class="border-b border-amber-600/15 bg-amber-50 px-4 py-2.5 sm:px-6 xl:px-8" role="status">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center gap-x-3 gap-y-2 text-[13px] text-amber-800">
      <%= icon(:key, size: 16, css: "text-amber-700") %>
      <p class="min-w-0 flex-1">
        Seu perfil exige verificação em duas etapas. Ative até <strong class="font-semibold text-amber-900"><%= l(requirement.deadline, format: :short) %></strong> para manter o acesso.
      </p>
      <%= link_to "Ativar agora", new_account_two_factor_path, class: "sv-btn-secondary sv-btn-sm" %>
    </div>
  </div>
<% end %>

<aside id="navegacao" class="invisible fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col border-r border-ink-200 bg-ink-100 transition-transform duration-200 lg:visible lg:w-64 lg:translate-x-0"
       data-shell-target="sidebar" aria-label="Navegação principal">
  <div class="flex h-14 shrink-0 items-center justify-between px-4 pt-0.5">
    <%= link_to dashboard_path, class: "rounded-md", aria: { label: "Servora, painel" } do %><%= render "shared/logo", size: 24 %><% end %>
    <button type="button" class="sv-btn-ghost size-8 p-0 lg:hidden" data-action="shell#close" aria-label="Fechar navegação">
      <%= icon(:close, size: 18) %>
    </button>
  </div>

  <div class="space-y-1 px-3 pb-4">
    <%= link_to organizations_path, class: "group flex h-11 items-center gap-2.5 rounded-lg px-2 transition-colors hover:bg-ink-950/[0.04]" do %>
      <span class="grid size-7 shrink-0 place-items-center rounded-md bg-white text-[11px] font-semibold text-ink-800 ring-1 ring-ink-200">
        <%= current_organization.name.split.first(2).pluck(0).join.upcase %>
      </span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-[13px] font-semibold leading-tight text-ink-950"><%= current_organization.name %></span>
        <span class="block text-[11px] leading-tight text-ink-600">Trocar organização</span>
      </span>
      <%= icon(:switch, size: 14, css: "text-ink-400 group-hover:text-ink-700") %>
    <% end %>

    <% if can?(:work_orders_manage) %>
      <%= link_to new_work_order_path, class: "group flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px] font-semibold text-ink-950 transition-colors hover:bg-ink-950/[0.04]" do %>
        <span class="grid size-[18px] place-items-center rounded-full bg-brand-600 text-white" aria-hidden="true"><%= icon(:plus, size: 12) %></span>
        Nova ordem de serviço
      <% end %>
    <% end %>
  </div>

  <nav class="flex-1 space-y-5 overflow-y-auto px-3 pb-6" aria-label="Seções">
    <% navigation_groups.each do |title, items| %>
      <div>
        <p class="mb-1.5 px-2 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink-500"><%= title %></p>
        <ul class="space-y-0.5" role="list">
          <% items.each do |item| %>
            <li><%= nav_link(item.label, public_send(item.route), icon_name: item.icon, active: nav_item_active?(item)) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </nav>

  <%= link_to account_security_path, class: "flex shrink-0 items-center gap-2.5 border-t border-ink-200 px-4 py-3 transition-colors hover:bg-ink-950/[0.03]" do %>
    <%= avatar(current_user.name, size: :sm) %>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-[13px] font-semibold leading-tight text-ink-950"><%= current_user.name %></span>
      <span class="block truncate text-[11px] leading-tight text-ink-600"><%= current_membership.role_label %></span>
    </span>
    <%= icon(:settings, size: 16, css: "text-ink-400") %>
  <% end %>
</aside>

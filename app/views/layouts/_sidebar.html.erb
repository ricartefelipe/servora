<aside id="navegacao" class="invisible fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col bg-ink-950 transition-transform duration-200 lg:visible lg:translate-x-0"
       data-shell-target="sidebar" aria-label="Navegação principal">
  <div class="flex h-16 items-center justify-between px-5">
    <%= link_to dashboard_path, class: "rounded-lg" do %><%= render "shared/logo", tone: :light, size: 30 %><% end %>
    <button type="button" class="rounded-lg p-2 text-ink-400 hover:bg-white/5 hover:text-white lg:hidden" data-action="shell#close" aria-label="Fechar navegação">
      <%= icon(:close) %>
    </button>
  </div>

  <div class="px-4 pb-4">
    <%= link_to organizations_path, class: "group flex items-center gap-3 rounded-2xl bg-white/5 p-3 ring-1 ring-white/10 transition hover:bg-white/10" do %>
      <span class="grid size-9 place-items-center rounded-xl bg-brand-600/20 text-brand-300"><%= icon(:building, size: 18) %></span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-semibold text-white"><%= current_organization.name %></span>
        <span class="block text-xs text-ink-400">Trocar organização</span>
      </span>
      <%= icon(:switch, size: 16, css: "text-ink-500 group-hover:text-brand-300") %>
    <% end %>
  </div>

  <nav class="flex-1 space-y-6 overflow-y-auto px-4 pb-6">
    <% navigation_groups.each do |title, items| %>
      <div>
        <p class="mb-2 px-3 text-[11px] font-semibold uppercase tracking-widest text-ink-500"><%= title %></p>
        <ul class="space-y-0.5" role="list">
          <% items.each do |item| %>
            <li><%= nav_link(item.label, public_send(item.route), icon_name: item.icon, active: nav_item_active?(item)) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </nav>

  <div class="border-t border-white/10 p-4 text-xs text-ink-500">
    <p>Perfil: <span class="font-semibold text-ink-300"><%= current_membership.role_label %></span></p>
    <p class="mt-1 text-ink-600">Servora <%= Servora::VERSION %></p>
  </div>
</aside>

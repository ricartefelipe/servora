<% content_for :title, "Mudar de local" %>
<%= render layout: "shared/modal", locals: { title: "Mudar de local", subtitle: @equipment.title } do %>
  <%= form_with url: relocate_equipment_path(@equipment), method: :patch, scope: :relocation, class: "space-y-5", data: { turbo_frame: "_top" } do |f| %>
    <%= f.hidden_field :lock_version, value: @equipment.lock_version %>
    <div>
      <%= f.label :service_location_id, "Novo local", class: "sv-label" %>
      <%= f.select :service_location_id, grouped_options_for_select(
            policy_scope(current_organization.customers).active.includes(:service_locations).alphabetical.map { |customer|
              [customer.display_name, customer.service_locations.select { |l| l.archived_at.nil? && l.id != @equipment.service_location_id }.map { |l| [l.name, l.id] }]
            }.reject { |_, locations| locations.empty? }), {}, class: "sv-input", required: true %>
      <p class="sv-hint">Escolher um local de outro cliente registra uma transferência de proprietário.</p>
    </div>
    <div>
      <%= f.label :reason, "Motivo", class: "sv-label" %>
      <%= f.text_field :reason, class: "sv-input", placeholder: "Ex.: equipamento remanejado para a filial" %>
    </div>
    <div class="flex justify-end"><%= f.button "Confirmar mudança", type: "submit", class: "sv-btn-primary" %></div>
  <% end %>
<% end %>

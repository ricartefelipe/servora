<% content_for :title, "Estoque" %>
<% stock_policy = policy(StockBalance) %>
<% show_costs = stock_policy.view_costs? %>
<%= render "stock/header" %>

<div class="mb-6 grid gap-4 sm:grid-cols-3">
  <%= stat_tile("Posições com saldo", @summary.positions, hint: @warehouse ? @warehouse.name : "Todos os depósitos visíveis") %>
  <%= stat_tile("Abaixo do mínimo", @summary.below_minimum, hint: "Disponível menor que o mínimo definido", tone: @summary.below_minimum.positive? ? :danger : :brand) %>
  <% if show_costs %>
    <%= stat_tile("Valor em estoque", money(@summary.stock_value), hint: "Saldo físico × custo médio") %>
  <% end %>
</div>

<%= form_with url: stock_balances_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do |f| %>
  <div class="min-w-64 flex-1">
    <%= f.label :q, "Buscar item", class: "sv-label" %>
    <%= f.search_field :q, value: params[:q], placeholder: "Nome ou código", class: "sv-input" %>
  </div>
  <div>
    <%= f.label :deposito, "Depósito", class: "sv-label" %>
    <%= f.select :deposito, @warehouses.map { |w| [w.name, w.id] }, { include_blank: "Todos", selected: @warehouse&.id }, class: "sv-input" %>
  </div>
  <label class="flex items-center gap-2 pb-2.5 text-sm text-ink-700">
    <%= f.check_box :abaixo, { checked: params[:abaixo] == "1", class: "rounded border-ink-300 text-brand-600" }, "1", nil %> Só abaixo do mínimo
  </label>
  <%= f.button "Filtrar", type: "submit", class: "sv-btn-secondary" %>
<% end %>

<section class="sv-card overflow-hidden" aria-label="Saldos de estoque">
  <% if @pagination.records.empty? %>
    <%= empty_state(@warehouses.empty? ? "Nenhum depósito cadastrado" : "Nenhum saldo encontrado",
          description: @warehouses.empty? ? "Cadastre um depósito para registrar entradas de peças." : "Registre uma entrada ou ajuste os filtros.",
          icon_name: :stock) do %>
      <% if @warehouses.empty? && policy(Warehouse).create? %>
        <%= link_to "Cadastrar depósito", new_warehouse_path, class: "sv-btn-primary", data: { turbo_frame: "modal" } %>
      <% end %>
    <% end %>
  <% else %>
    <div class="relative overflow-x-auto">
      <table class="sv-table">
        <thead>
          <tr>
            <th scope="col">Item</th><th scope="col">Depósito</th>
            <th scope="col" class="text-right">Físico</th><th scope="col" class="text-right">Reservado</th>
            <th scope="col" class="text-right">Disponível</th><th scope="col" class="text-right">Mínimo</th>
            <% if show_costs %><th scope="col" class="text-right">Custo médio</th><th scope="col" class="text-right">Valor</th><% end %>
            <th scope="col"><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          <% @pagination.records.each do |balance| %>
            <% item = balance.catalog_item %>
            <tr>
              <td>
                <span class="block font-medium text-ink-900"><%= item.name %></span>
                <span class="text-xs text-ink-500"><%= [item.sku, item.unit_label].compact.join(" · ") %></span>
              </td>
              <td><%= balance.warehouse.name %><span class="block text-xs text-ink-500"><%= balance.warehouse.kind_label %></span></td>
              <td class="sv-num text-right"><%= quantity(balance.on_hand) %></td>
              <td class="sv-num text-right text-ink-600"><%= quantity(balance.reserved) %></td>
              <td class="sv-num text-right font-semibold <%= balance.below_minimum? ? 'text-amber-800' : 'text-ink-900' %>">
                <%= quantity(balance.available) %>
                <% if balance.below_minimum? %><span class="block"><%= badge("Abaixo do mínimo", tone: :warning) %></span><% end %>
              </td>
              <td class="sv-num text-right">
                <% if stock_policy.set_minimum? %>
                  <details class="relative inline-block text-left">
                    <summary class="sv-link cursor-pointer list-none" aria-label="Alterar estoque mínimo de <%= item.name %> em <%= balance.warehouse.name %>"><%= quantity(balance.minimum_quantity) %></summary>
                    <%= form_with url: minimum_stock_balances_path, method: :patch, scope: :stock_minimum, class: "absolute right-0 z-10 mt-2 w-56 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
                      <%= f.hidden_field :warehouse_id, value: balance.warehouse_id %>
                      <%= f.hidden_field :catalog_item_id, value: balance.catalog_item_id %>
                      <div><%= f.label :minimum, "Estoque mínimo", class: "sv-label", for: "minimo-#{balance.id}" %><%= f.number_field :minimum, value: balance.minimum_quantity.to_s("F"), id: "minimo-#{balance.id}", step: "0.001", min: 0, class: "sv-input" %></div>
                      <%= f.button "Salvar", type: "submit", class: "sv-btn-primary w-full" %>
                    <% end %>
                  </details>
                <% else %>
                  <%= quantity(balance.minimum_quantity) %>
                <% end %>
              </td>
              <% if show_costs %>
                <td class="sv-num text-right text-ink-600"><%= unit_cost(balance.average_cost) %></td>
                <td class="sv-num text-right"><%= money(balance.stock_value) %></td>
              <% end %>
              <td class="text-right">
                <%= link_to "Movimentações", stock_movements_path(deposito: balance.warehouse_id, item: balance.catalog_item_id), class: "sv-btn-ghost sv-btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
<%= render "shared/pagination", pagination: @pagination %>

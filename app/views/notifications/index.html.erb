<% content_for :title, "Notificações" %>
<%= page_header("Notificações", eyebrow: "Conta · Notificações", subtitle: "Avisos sobre a sua equipe e a sua operação.") do %>
  <% if @notifications.any? { |n| !n.read? } %>
    <%= button_to "Marcar todas como lidas", read_all_notifications_path, method: :patch, class: "sv-btn-secondary sv-btn-sm" %>
  <% end %>
<% end %>

<section class="sv-card overflow-hidden">
  <%# A role-based list: items are also prepended in real time, outside this template. %>
  <div id="notifications-feed" class="divide-y divide-ink-150" role="list">
    <% @notifications.each do |notification| %>
      <%= render "notifications/notification", notification: %>
    <% end %>
  </div>
  <% if @notifications.empty? %>
    <%= empty_state("Nenhuma notificação", description: "Quando algo precisar da sua atenção, aparecerá aqui.", icon_name: :bell) %>
  <% end %>
</section>

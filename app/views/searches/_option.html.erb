<%# One result row: mono code, title and a muted detail line.
    In the palette (listbox: true) the link is an ARIA option that never takes
    focus from the input; the command-palette controller marks the active one
    with aria-selected. %>
<% detail_text = Array(detail).compact_blank.join(" · ") %>
<% option = listbox ? {
     id: dom_id(record, :busca), role: "option", tabindex: "-1", aria: { selected: "false" },
     data: { command_palette_target: "option", action: "mousemove->command-palette#hover click->command-palette#choose" }
   } : {} %>
<%= link_to path, **option,
      class: "flex h-10 items-center gap-3 px-4 text-[13px] transition-colors hover:bg-white/[0.04] focus-visible:-outline-offset-2 focus-visible:outline-brand-300 aria-selected:bg-white/[0.06] aria-selected:shadow-[inset_2px_0_0_var(--color-brand-300)]" do %>
  <span class="w-28 shrink-0 truncate font-mono text-[12px] text-white/60 sm:w-36"><%= code %></span>
  <span class="min-w-0 flex-1 truncate font-medium text-white"><%= label %></span>
  <% if detail_text.present? %>
    <span class="hidden max-w-[45%] truncate text-[12px] text-white/60 sm:block"><%= detail_text %></span>
  <% end %>
<% end %>

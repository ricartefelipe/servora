<% content_for :title, "Tipos de serviço" %>
<%= page_header("Tipos de serviço", subtitle: "Cada tipo define o checklist exigido para concluir a ordem.") do %>
  <%= link_to new_service_type_path, class: "sv-btn-primary" do %><%= icon(:plus, size: 18) %> Novo tipo<% end %>
<% end %>
<% if @service_types.empty? %>
  <section class="sv-card"><%= empty_state("Nenhum tipo cadastrado", description: "Exemplos: manutenção preventiva de split, instalação, inspeção de elevador.", icon_name: :check) %></section>
<% else %>
  <div class="grid gap-4 md:grid-cols-2">
    <% @service_types.each do |service_type| %>
      <article class="sv-card p-5 <%= 'opacity-60' unless service_type.active? %>">
        <div class="flex items-start justify-between gap-3">
          <h2 class="font-semibold text-ink-900"><%= service_type.name %></h2>
          <%= link_to "Editar", edit_service_type_path(service_type), class: "sv-btn-ghost sv-btn-sm" %>
        </div>
        <ul class="mt-3 space-y-1 text-sm text-ink-700" role="list">
          <% service_type.checklist_items.each do |item| %>
            <li class="flex items-center gap-2"><%= icon(:check, size: 14, css: "text-ink-400") %><%= item.label %><% if item.required %><span class="text-xs text-rose-600">obrigatório</span><% end %></li>
          <% end %>
        </ul>
      </article>
    <% end %>
  </div>
<% end %>

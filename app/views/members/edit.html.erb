<% content_for :title, "Editar membro" %>
<%= page_header(@membership.user.name, eyebrow: "Equipe", subtitle: @membership.user.email) %>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="sv-card p-6 lg:col-span-2">
    <%= form_with model: @membership, url: member_path(@membership), scope: :membership, class: "space-y-5" do |f| %>
      <%= f.error_summary %>
      <%= f.select_field :role, policy(@membership).assignable_roles.map { |role| [Membership::ROLE_LABELS[role], role] }, label: "Perfil de acesso" %>
      <div class="grid gap-5 sm:grid-cols-2">
        <%= f.field :job_title, label: "Cargo" %>
        <%= f.field :phone, label: "Telefone", as: :telephone_field %>
      </div>
      <% if policy(@membership).view_costs? %>
        <%= f.field :hourly_cost, label: "Custo interno por hora (R$)", as: :number_field, step: "0.01", min: 0,
              hint: "Usado no custo de mão de obra dos apontamentos. Visível apenas para perfis com acesso a custos." %>
      <% end %>
      <div class="flex gap-3">
        <%= f.submit_button "Salvar" %>
        <%= link_to "Cancelar", members_path, class: "sv-btn-secondary" %>
      </div>
    <% end %>
  </section>

  <aside class="sv-card p-6">
    <h2 class="font-semibold text-ink-900">Acesso</h2>
    <% if @membership.active? %>
      <p class="mt-1 text-sm text-ink-600">Desativar remove o acesso imediatamente, inclusive de sessões abertas.</p>
      <% if policy(@membership).deactivate? %>
        <%= button_to "Desativar acesso", deactivate_member_path(@membership), method: :patch, class: "sv-btn-danger mt-4 w-full",
              form: { data: { turbo_confirm: "Desativar o acesso de #{@membership.user.name}?" } } %>
      <% end %>
    <% else %>
      <p class="mt-1 text-sm text-ink-600">Acesso desativado em <%= l(@membership.deactivated_at, format: :short) %>.</p>
      <% if policy(@membership).reactivate? %>
        <%= button_to "Reativar acesso", reactivate_member_path(@membership), method: :patch, class: "sv-btn-secondary mt-4 w-full" %>
      <% end %>
    <% end %>
  </aside>
</div>

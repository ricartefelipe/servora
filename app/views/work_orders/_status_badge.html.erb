<% tones = { "open" => :info, "awaiting_approval" => :warning, "approved" => :brand, "scheduled" => :brand, "in_progress" => :ember,
             "waiting_parts" => :warning, "waiting_customer" => :warning, "completed" => :success, "reopened" => :danger, "canceled" => :neutral } %>
<%= badge(work_order.status_label, tone: tones.fetch(work_order.status)) %>

<%# "Anexos" tab: photos and documents, streamed by an authorized controller. %>
<section id="painel-anexos" role="tabpanel" aria-labelledby="aba-anexos" data-tabs-target="panel" class="space-y-6" hidden>
  <% if wo_policy.add_evidence? %>
    <div class="sv-card p-5">
      <h2 class="mb-1 text-[15px] font-semibold text-ink-950">Enviar foto ou documento</h2>
      <p class="mb-3 text-sm text-ink-500">JPEG, PNG, WebP ou PDF de até 15 MB. O formato é conferido pelo conteúdo do arquivo.</p>
      <%= form_with url: work_order_evidences_path(@work_order), scope: :evidence, multipart: true, class: "grid gap-3 sm:grid-cols-6" do |f| %>
        <div class="sm:col-span-3">
          <%= f.label :file, "Arquivo", class: "sv-label" %>
          <%= f.file_field :file, accept: "image/jpeg,image/png,image/webp,application/pdf", required: true, class: "block w-full text-sm text-ink-700 file:mr-3 file:h-9 file:cursor-pointer file:rounded-lg file:border-0 file:bg-white file:px-3.5 file:text-[13px] file:font-semibold file:text-ink-900 file:ring-1 file:ring-inset file:ring-ink-300 hover:file:bg-ink-25" %>
        </div>
        <div class="sm:col-span-2"><%= f.label :caption, "Legenda", class: "sv-label" %><%= f.text_field :caption, maxlength: 200, class: "sv-input", placeholder: "Ex.: antes da limpeza" %></div>
        <div class="flex items-end"><%= f.button "Enviar", type: "submit", class: "sv-btn-primary w-full", data: { turbo_submits_with: "Enviando…" } %></div>
      <% end %>
    </div>
  <% end %>

  <% if @evidences.empty? %>
    <div class="sv-card"><%= empty_state("Nenhum anexo", description: "Fotos de antes e depois e documentos do atendimento aparecem aqui.", icon_name: :camera) %></div>
  <% else %>
    <ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3" role="list">
      <% @evidences.each do |evidence| %>
        <li class="sv-card overflow-hidden">
          <% if evidence.photo? %>
            <%= link_to work_order_evidence_path(@work_order, evidence), target: "_blank", rel: "noopener", data: { turbo: false } do %>
              <%= image_tag work_order_evidence_path(@work_order, evidence), alt: evidence.caption.presence || "Foto anexada em #{l(evidence.created_at, format: :short)}", loading: "lazy", class: "aspect-[4/3] w-full bg-ink-100 object-cover" %>
            <% end %>
          <% else %>
            <%= link_to work_order_evidence_path(@work_order, evidence), class: "flex aspect-[4/3] items-center justify-center bg-ink-50 text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-950", data: { turbo: false } do %>
              <%= icon(:quote, size: 40, label: "Baixar documento #{evidence.original_filename}") %>
            <% end %>
          <% end %>
          <div class="flex items-start gap-2 p-3 text-sm">
            <div class="min-w-0 flex-1">
              <p class="truncate font-medium text-ink-900"><%= evidence.caption.presence || evidence.original_filename %></p>
              <p class="text-xs text-ink-500"><%= evidence.kind_label %> · <%= number_to_human_size(evidence.byte_size) %> · <%= evidence.uploaded_by.user.name %></p>
            </div>
            <% if wo_policy.remove_evidence? %>
              <%= button_to work_order_evidence_path(@work_order, evidence), method: :delete, class: "grid size-8 place-items-center rounded-lg text-ink-500 transition-colors hover:bg-rose-50 hover:text-rose-700",
                    form: { data: { turbo_confirm: "Remover este anexo?" } } do %><%= icon(:trash, size: 16, label: "Remover anexo") %><% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

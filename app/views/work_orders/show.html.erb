<% content_for :title, @work_order.number %>
<% wo_policy = policy(@work_order) %>
<% show_prices = wo_policy.view_prices? %>
<%= page_header(@work_order.title, eyebrow: "#{@work_order.number} · #{@work_order.origin_label}",
      subtitle: "#{@work_order.customer.display_name} · #{@work_order.service_location.name} · #{@work_order.service_location.address_line}") do %>
  <%= render "work_orders/priority_badge", work_order: @work_order %>
  <%= render "work_orders/status_badge", work_order: @work_order %>
  <% if wo_policy.complete? && WorkOrders::States.allowed?(@work_order.status, "completed") %>
    <%= button_to complete_work_order_path(@work_order), method: :post, class: "sv-btn-primary",
          form: { data: { turbo_confirm: "Concluir a ordem #{@work_order.number}? O relatório será registrado." } } do %>
      <%= icon(:check, size: 18) %> Concluir
    <% end %>
  <% end %>
<% end %>

<% if wo_policy.change_status? || wo_policy.cancel? || wo_policy.reopen? %>
  <section class="sv-card mb-6 flex flex-wrap items-center gap-3 p-4" aria-label="Ações da ordem">
    <% targets = WorkOrders::States.targets(@work_order.status) & WorkOrders::ChangeStatus::ALLOWED_TARGETS %>
    <% if wo_policy.change_status? && targets.any? %>
      <%= form_with url: change_status_work_order_path(@work_order), method: :patch, scope: :status_change, class: "flex flex-wrap items-end gap-2" do |f| %>
        <div><%= f.label :to, "Mover para", class: "sv-label" %><%= f.select :to, targets.map { |s| [WorkOrders::LABELS[s], s] }, {}, class: "sv-input" %></div>
        <div><%= f.label :reason, "Motivo", class: "sv-label" %><%= f.text_field :reason, class: "sv-input", placeholder: "Obrigatório para esperas" %></div>
        <%= f.button "Atualizar", type: "submit", class: "sv-btn-secondary" %>
      <% end %>
    <% end %>
    <div class="ml-auto flex flex-wrap gap-2">
      <% if wo_policy.cancel? %>
        <details class="relative">
          <summary class="sv-btn-ghost cursor-pointer list-none text-rose-700">Cancelar ordem</summary>
          <%= form_with url: cancel_work_order_path(@work_order), method: :patch, scope: :cancellation, class: "absolute right-0 z-10 mt-2 w-80 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
            <%= f.label :reason, "Motivo do cancelamento", class: "sv-label" %>
            <%= f.text_area :reason, rows: 2, required: true, class: "sv-input" %>
            <%= f.button "Confirmar cancelamento", type: "submit", class: "sv-btn-danger w-full" %>
          <% end %>
        </details>
      <% end %>
      <% if wo_policy.reopen? %>
        <details class="relative">
          <summary class="sv-btn-secondary cursor-pointer list-none">Reabrir</summary>
          <%= form_with url: reopen_work_order_path(@work_order), method: :patch, scope: :reopening, class: "absolute right-0 z-10 mt-2 w-80 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
            <%= f.label :reason, "Motivo da reabertura", class: "sv-label" %>
            <%= f.text_area :reason, rows: 2, required: true, class: "sv-input" %>
            <%= f.button "Reabrir ordem", type: "submit", class: "sv-btn-primary w-full" %>
          <% end %>
        </details>
      <% end %>
    </div>
  </section>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="min-w-0 lg:col-span-2" data-controller="tabs">
    <%= render "shared/tabs", label: "Seções da ordem", tabs: [
          ["execucao", "Execução", nil], ["visitas", "Visitas", @work_order.visits.size],
          ["itens", "Serviços e materiais", @work_order.items.size],
          *([["materiais", "Materiais", @consumptions.size]] if wo_policy.view_materials?),
          ["historico", "Histórico", nil], ["relatorios", "Relatórios", @work_order.reports.size]] %>

    <section id="painel-execucao" role="tabpanel" aria-labelledby="aba-execucao" data-tabs-target="panel" class="space-y-6">
      <div class="sv-card p-5">
        <h2 class="font-semibold text-ink-900">Problema relatado</h2>
        <p class="mt-2 whitespace-pre-line text-sm text-ink-700"><%= @work_order.problem_description %></p>
      </div>

      <div class="sv-card p-5">
        <h2 class="mb-3 font-semibold text-ink-900">Registro técnico</h2>
        <% if wo_policy.update_execution? %>
          <%= form_with url: update_report_work_order_path(@work_order), method: :patch, scope: :report, class: "space-y-4" do |f| %>
            <%= f.hidden_field :lock_version, value: @work_order.lock_version %>
            <div><%= f.label :diagnosis, "Diagnóstico", class: "sv-label" %><%= f.text_area :diagnosis, value: @work_order.diagnosis, rows: 3, class: "sv-input" %></div>
            <div><%= f.label :solution, "Solução aplicada", class: "sv-label" %><%= f.text_area :solution, value: @work_order.solution, rows: 3, class: "sv-input" %></div>
            <%= f.button "Salvar registro técnico", type: "submit", class: "sv-btn-secondary" %>
          <% end %>
        <% else %>
          <dl class="space-y-3 text-sm">
            <div><dt class="text-ink-500">Diagnóstico</dt><dd class="whitespace-pre-line text-ink-800"><%= @work_order.diagnosis.presence || "—" %></dd></div>
            <div><dt class="text-ink-500">Solução aplicada</dt><dd class="whitespace-pre-line text-ink-800"><%= @work_order.solution.presence || "—" %></dd></div>
          </dl>
        <% end %>
      </div>

      <div class="sv-card overflow-hidden">
        <h2 class="border-b border-ink-100 px-5 py-4 font-semibold text-ink-900">Checklist <% if @work_order.service_type %><span class="text-sm font-normal text-ink-500">· <%= @work_order.service_type.name %></span><% end %></h2>
        <% if @work_order.checklist_items.empty? %>
          <%= empty_state("Sem checklist", description: "Defina um tipo de serviço com checklist para exigir verificações na conclusão.", icon_name: :check) %>
        <% else %>
          <ul class="divide-y divide-ink-100" role="list">
            <% @work_order.checklist_items.each do |item| %>
              <li class="flex flex-wrap items-center gap-3 px-5 py-3">
                <span class="grid size-6 place-items-center rounded-full <%= item.answered? ? 'bg-emerald-100 text-emerald-700' : 'bg-ink-100 text-ink-400' %>"><%= icon(item.answered? ? :check : :clock, size: 14, label: item.answered? ? "Respondido" : "Pendente") %></span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-ink-900"><%= item.label %><% if item.required %> <span class="text-rose-600" aria-label="obrigatório">*</span><% end %></p>
                  <% if item.answered? %><p class="text-xs text-ink-500"><%= item.response %> · <%= item.responded_by&.user&.name %></p><% end %>
                </div>
                <% if wo_policy.update_execution? %>
                  <%= form_with url: work_order_checklist_item_path(@work_order, item), method: :patch, scope: :answer, class: "flex items-center gap-2" do |f| %>
                    <%= f.hidden_field :lock_version, value: item.lock_version %>
                    <% if item.response_kind == "check" %>
                      <%= f.select :response, [["Sim", "sim"], ["Não", "nao"]], { selected: item.response, include_blank: "—" }, class: "sv-input py-1.5", aria: { label: item.label } %>
                    <% else %>
                      <%= f.text_field :response, value: item.response, class: "sv-input w-40 py-1.5", inputmode: (item.response_kind == "number" ? "decimal" : nil), aria: { label: item.label } %>
                    <% end %>
                    <%= f.button "Salvar", type: "submit", class: "sv-btn-ghost sv-btn-sm" %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>

    <section id="painel-visitas" role="tabpanel" aria-labelledby="aba-visitas" data-tabs-target="panel" class="space-y-4" hidden>
      <% if policy(Visit).create? && !@work_order.finished? %>
        <%= link_to new_work_order_visit_path(@work_order), class: "sv-btn-primary sv-btn-sm" do %><%= icon(:calendar, size: 16) %> Agendar visita<% end %>
      <% end %>
      <% if @work_order.visits.empty? %>
        <div class="sv-card"><%= empty_state("Nenhuma visita agendada", description: "Uma ordem pode precisar de várias visitas.", icon_name: :calendar) %></div>
      <% end %>
      <% @work_order.visits.each do |visit| %>
        <% visit_policy = policy(visit) %>
        <article class="sv-card p-4">
          <div class="flex flex-wrap items-center gap-3">
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-ink-900"><%= l(visit.scheduled_start, format: :short) %>–<%= l(visit.scheduled_end, format: "%H:%M") %></p>
              <p class="text-sm text-ink-600"><%= visit.allocations.map { |a| a.membership.user.name }.uniq.join(", ") %> · deslocamento <%= visit.travel_minutes %> min</p>
              <% if visit.outcome_note.present? %><p class="mt-1 text-sm text-ink-500"><%= visit.outcome_note %><%= " · precisa de retorno" if visit.needs_return %></p><% end %>
            </div>
            <%= badge(visit.status_label, tone: { "scheduled" => :brand, "in_progress" => :ember, "completed" => :success }.fetch(visit.status, :neutral)) %>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if visit.scheduled? && visit_policy.execute? %>
              <%= button_to "Iniciar visita", start_work_order_visit_path(@work_order, visit), method: :patch, class: "sv-btn-secondary sv-btn-sm" %>
            <% end %>
            <% if visit.in_progress? && visit_policy.execute? %>
              <details class="relative">
                <summary class="sv-btn-primary sv-btn-sm cursor-pointer list-none">Finalizar visita</summary>
                <%= form_with url: finish_work_order_visit_path(@work_order, visit), method: :patch, scope: :finish, class: "absolute left-0 z-10 mt-2 w-80 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
                  <%= f.label :outcome_note, "Resultado da visita", class: "sv-label" %>
                  <%= f.text_area :outcome_note, rows: 2, class: "sv-input" %>
                  <label class="flex items-center gap-2 text-sm"><%= f.check_box :needs_return, class: "rounded border-ink-300 text-brand-600" %> Precisa de nova visita</label>
                  <%= f.button "Finalizar", type: "submit", class: "sv-btn-primary w-full" %>
                <% end %>
              </details>
            <% end %>
            <% if visit.scheduled? && visit_policy.manage? %>
              <%= link_to "Reagendar", edit_work_order_visit_path(@work_order, visit), class: "sv-btn-ghost sv-btn-sm" %>
              <details class="relative">
                <summary class="sv-btn-ghost sv-btn-sm cursor-pointer list-none text-rose-700">Cancelar</summary>
                <%= form_with url: cancel_work_order_visit_path(@work_order, visit), method: :patch, scope: :cancellation, class: "absolute left-0 z-10 mt-2 w-80 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
                  <%= f.label :reason, "Motivo", class: "sv-label" %>
                  <%= f.text_field :reason, class: "sv-input", required: true %>
                  <label class="flex items-center gap-2 text-sm"><%= f.check_box :no_show, class: "rounded border-ink-300" %> Cliente ausente no local</label>
                  <%= f.button "Cancelar visita", type: "submit", class: "sv-btn-danger w-full" %>
                <% end %>
              </details>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>

    <section id="painel-itens" role="tabpanel" aria-labelledby="aba-itens" data-tabs-target="panel" class="space-y-6" hidden>
      <div class="sv-card overflow-hidden">
        <% if @work_order.items.empty? %>
          <%= empty_state("Nenhum item", icon_name: :catalog) %>
        <% else %>
          <ul class="divide-y divide-ink-100" role="list">
            <% @work_order.items.each do |item| %>
              <li class="flex flex-wrap items-center gap-3 px-5 py-3">
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-ink-900"><%= item.description %></p>
                  <p class="text-xs text-ink-500"><%= quantity(item.quantity, item.unit) %> · <%= WorkOrderItem::SOURCES[item.source] %><% if show_prices %> · <%= money(item.line_total) %><% end %>
                    <% if item.authorized_by_contact %> · por <%= item.authorized_by_contact.name %><% end %></p>
                </div>
                <%= badge(item.authorization_label, tone: { "authorized" => :success, "pending" => :warning, "rejected" => :danger }.fetch(item.authorization_status)) %>
                <% if item.pending? && wo_policy.decide_item? && @approvers.present? %>
                  <details class="relative">
                    <summary class="sv-btn-secondary sv-btn-sm cursor-pointer list-none">Registrar decisão</summary>
                    <%= form_with url: decide_work_order_item_path(@work_order, item), method: :patch, scope: :decision, class: "absolute right-0 z-10 mt-2 w-80 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
                      <div><%= f.label :contact_id, "Quem decidiu", class: "sv-label" %><%= f.select :contact_id, @approvers.map { |c| [c.name, c.id] }, {}, class: "sv-input" %></div>
                      <div><%= f.label :channel, "Canal", class: "sv-label" %><%= f.select :channel, Quotes::Decide::CHANNELS.map { |v, l| [l, v] }, {}, class: "sv-input" %></div>
                      <div><%= f.label :outcome, "Decisão", class: "sv-label" %><%= f.select :outcome, [["Autorizou", "authorized"], ["Recusou", "rejected"]], {}, class: "sv-input" %></div>
                      <div><%= f.label :note, "Evidência", class: "sv-label" %><%= f.text_field :note, class: "sv-input" %></div>
                      <%= f.button "Registrar", type: "submit", class: "sv-btn-primary w-full" %>
                    <% end %>
                  </details>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <% if wo_policy.add_item? %>
        <div class="sv-card p-5">
          <h2 class="mb-1 font-semibold text-ink-900">Serviço ou material adicional</h2>
          <p class="mb-3 text-sm text-ink-500">Itens adicionais só entram na cobrança depois de autorizados pelo cliente.</p>
          <%= form_with url: work_order_items_path(@work_order), scope: :item, class: "grid gap-3 sm:grid-cols-6" do |f| %>
            <div class="sm:col-span-3"><%= f.label :catalog_item_id, "Do catálogo", class: "sv-label" %><%= f.select :catalog_item_id, @catalog.map { |i| [i.name, i.id] }, { include_blank: "Item avulso" }, class: "sv-input" %></div>
            <div class="sm:col-span-3"><%= f.label :description, "Descrição (avulso)", class: "sv-label" %><%= f.text_field :description, class: "sv-input" %></div>
            <div><%= f.label :quantity, "Qtd.", class: "sv-label" %><%= f.number_field :quantity, value: 1, step: "0.001", min: "0.001", class: "sv-input", required: true %></div>
            <div><%= f.label :unit_price, "Preço", class: "sv-label" %><%= f.number_field :unit_price, step: "0.01", min: 0, class: "sv-input", placeholder: "do catálogo" %></div>
            <div class="sm:col-span-4 flex items-end"><%= f.button "Incluir item adicional", type: "submit", class: "sv-btn-secondary" %></div>
          <% end %>
        </div>
      <% end %>
    </section>

    <% if wo_policy.view_materials? %><%= render "work_orders/materials", wo_policy: %><% end %>

    <section id="painel-historico" role="tabpanel" aria-labelledby="aba-historico" data-tabs-target="panel" hidden>
      <ol class="sv-card divide-y divide-ink-100" role="list">
        <% @work_order.transitions.each do |transition| %>
          <li class="px-5 py-3 text-sm">
            <p class="font-medium text-ink-900"><%= [transition.from_label, transition.to_label].compact.join(" → ") %></p>
            <p class="text-xs text-ink-500"><%= l(transition.created_at, format: :short) %> · <%= transition.actor_label || "Sistema" %></p>
            <% if transition.reason.present? %><p class="mt-1 text-ink-600"><%= transition.reason %></p><% end %>
          </li>
        <% end %>
      </ol>
    </section>

    <section id="painel-relatorios" role="tabpanel" aria-labelledby="aba-relatorios" data-tabs-target="panel" hidden>
      <% if @work_order.reports.empty? %>
        <div class="sv-card"><%= empty_state("Nenhum relatório", description: "O relatório de execução é registrado a cada conclusão.", icon_name: :quote) %></div>
      <% else %>
        <ul class="space-y-3" role="list">
          <% @work_order.reports.each do |report| %>
            <li class="sv-card p-5 text-sm">
              <p class="font-semibold text-ink-900">Relatório versão <%= report.version_number %></p>
              <p class="text-xs text-ink-500">Registrado em <%= l(report.created_at, format: :short) %> · digest <span class="font-mono"><%= report.content_digest.first(12) %></span></p>
              <p class="mt-2 text-ink-700"><strong>Diagnóstico:</strong> <%= report.data["diagnosis"] %></p>
              <p class="text-ink-700"><strong>Solução:</strong> <%= report.data["solution"] %></p>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>

  <aside class="space-y-6">
    <% if @financials %><%= render "work_orders/finance", wo_policy: %><% end %>
    <section class="sv-card p-5 text-sm" aria-labelledby="cliente-title">
      <h2 id="cliente-title" class="mb-2 font-semibold text-ink-900">Atendimento</h2>
      <p class="font-medium text-ink-800"><%= @work_order.customer.display_name %></p>
      <p class="text-ink-600"><%= @work_order.service_location.address_line %></p>
      <p class="text-ink-500"><%= @work_order.service_location.city_line %></p>
      <% if @work_order.service_location.access_instructions.present? %><p class="mt-2 rounded-xl bg-ink-50 p-2 text-xs text-ink-600"><%= @work_order.service_location.access_instructions %></p><% end %>
      <p class="mt-3 text-xs text-ink-500">Solicitado em <%= l(@work_order.requested_at, format: :short) %><% if @work_order.reopened_count.positive? %> · reaberta <%= @work_order.reopened_count %>x<% end %></p>
    </section>

    <section class="sv-card p-5" aria-labelledby="equipamentos-title">
      <h2 id="equipamentos-title" class="mb-3 font-semibold text-ink-900">Equipamentos</h2>
      <% if @work_order.equipment.empty? %>
        <p class="text-sm text-ink-500">Nenhum equipamento vinculado.</p>
      <% else %>
        <ul class="space-y-2 text-sm" role="list">
          <% @work_order.work_order_equipment.map(&:equipment).each do |equipment| %>
            <li><%= link_to equipment.title, equipment_path(equipment), class: "sv-link" %><span class="block text-xs text-ink-500"><%= equipment.serial_number || "sem série" %></span></li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="sv-card p-5" aria-labelledby="tecnicos-title">
      <h2 id="tecnicos-title" class="mb-3 font-semibold text-ink-900">Técnicos</h2>
      <ul class="space-y-2" role="list">
        <% @work_order.assignments.each do |assignment| %>
          <li class="flex items-center gap-2 text-sm">
            <%= avatar(assignment.membership.user.name, size: :sm) %>
            <span class="flex-1 text-ink-800"><%= assignment.membership.user.name %></span>
            <% if wo_policy.assign? %>
              <%= button_to work_order_assignment_path(@work_order, assignment), method: :delete, class: "rounded-lg p-1 text-ink-400 hover:text-rose-700",
                    aria: { label: "Remover #{assignment.membership.user.name}" } do %><%= icon(:close, size: 14) %><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if wo_policy.assign? && @technicians.present? %>
        <%= form_with url: work_order_assignments_path(@work_order), scope: :assignment, class: "mt-3 flex gap-2" do |f| %>
          <%= f.select :membership_id, @technicians.map { |m| [m.user.name, m.id] }, {}, class: "sv-input py-1.5", aria: { label: "Técnico" } %>
          <%= f.button "Atribuir", type: "submit", class: "sv-btn-secondary sv-btn-sm" %>
        <% end %>
      <% end %>
    </section>

    <% if @work_order.quote_version %>
      <section class="sv-card p-5 text-sm">
        <h2 class="mb-1 font-semibold text-ink-900">Origem</h2>
        <%= link_to "Orçamento aprovado (#{@work_order.quote_version.label})", quote_path(@work_order.quote_version.quote_id), class: "sv-link" %>
      </section>
    <% end %>
  </aside>
</div>

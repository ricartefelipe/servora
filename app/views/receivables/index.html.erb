<% content_for :title, "Financeiro" %>
<%= page_header("Contas a receber", subtitle: "Faturamento por ordem de serviço, pagamentos parciais e cobranças. Valores em reais.") %>

<div class="mb-6 grid gap-4 sm:grid-cols-3">
  <%= stat_tile("Em aberto", money(@summary.outstanding), hint: "Saldo a receber de contas não quitadas") %>
  <%= stat_tile("Vencido", money(@summary.overdue), hint: "Saldo com vencimento anterior a hoje", tone: @summary.overdue.positive? ? :danger : :neutral) %>
  <%= stat_tile("Recebido no mês", money(@summary.received_this_month), hint: "Pagamentos menos estornos") %>
</div>

<nav class="mb-4 flex flex-wrap gap-2" aria-label="Filtrar por situação">
  <%= link_to "Todas", receivables_path, class: "sv-btn-sm #{@filter ? 'sv-btn-secondary' : 'sv-btn-primary'}", aria: { current: (@filter ? nil : "page") } %>
  <% Receivable::STATUSES.merge("overdue" => "Vencidas").each do |value, label| %>
    <%= link_to label, receivables_path(situacao: value), class: "sv-btn-sm #{@filter == value ? 'sv-btn-primary' : 'sv-btn-secondary'}",
          aria: { current: (@filter == value ? "page" : nil) } %>
  <% end %>
</nav>

<section class="sv-card overflow-hidden" aria-label="Contas a receber">
  <% if @pagination.records.empty? %>
    <%= empty_state("Nenhuma conta", description: "Fature uma ordem de serviço pelo painel financeiro da ordem.", icon_name: :finance) %>
  <% else %>
    <div class="relative overflow-x-auto">
      <table class="sv-table">
        <thead>
          <tr>
            <th scope="col">Conta</th><th scope="col">Cliente</th><th scope="col">Vencimento</th>
            <th scope="col" class="text-right">Valor</th><th scope="col" class="text-right">Saldo</th><th scope="col">Situação</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          <% @pagination.records.each do |receivable| %>
            <tr>
              <td>
                <%= link_to receivable.number, receivable_path(receivable), class: "sv-link font-mono text-xs" %>
                <span class="block text-xs text-ink-500"><%= receivable.work_order.number %></span>
              </td>
              <td><%= receivable.customer.display_name %></td>
              <td class="whitespace-nowrap"><%= date(receivable.due_on) %></td>
              <td class="sv-num text-right"><%= money(receivable.amount - receivable.discount_amount) %></td>
              <td class="sv-num text-right font-semibold"><%= receivable.canceled? ? "—" : money(receivable.balance) %></td>
              <td><%= render "receivables/status_badge", receivable: %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
<%= render "shared/pagination", pagination: @pagination %>

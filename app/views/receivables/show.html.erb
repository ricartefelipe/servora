<% content_for :title, @receivable.number %>
<% rp = policy(@receivable) %>
<% position = @receivable.position %>
<% active_charge = @charges.find(&:active?) %>
<%= page_header(@receivable.description, eyebrow: @receivable.number) do %>
  <%= render "receivables/status_badge", receivable: @receivable %>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="min-w-0 space-y-6 lg:col-span-2">
    <section class="sv-card p-5" aria-labelledby="posicao-title">
      <h2 id="posicao-title" class="sr-only">Posição da conta</h2>
      <dl class="grid gap-4 text-sm sm:grid-cols-4">
        <div><dt class="text-ink-500">Valor</dt><dd class="sv-num text-lg font-semibold text-ink-900"><%= money(position.amount) %></dd></div>
        <div><dt class="text-ink-500">Descontos</dt><dd class="sv-num text-lg font-semibold text-ink-900"><%= money(position.discount) %></dd></div>
        <div><dt class="text-ink-500">Recebido</dt><dd class="sv-num text-lg font-semibold text-ink-900"><%= money(position.net_paid) %></dd></div>
        <div><dt class="text-ink-500">Saldo</dt><dd class="sv-num text-lg font-bold <%= position.balance.positive? ? 'text-brand-700' : 'text-ink-900' %>"><%= @receivable.canceled? ? "—" : money(position.balance) %></dd></div>
      </dl>
      <% if @receivable.canceled? %>
        <p class="mt-4 rounded-xl bg-ink-50 p-3 text-sm text-ink-700">Cancelada em <%= date_time(@receivable.canceled_at) %>: <%= @receivable.cancel_reason %></p>
      <% end %>
    </section>

    <section class="sv-card overflow-hidden" aria-labelledby="pagamentos-title">
      <h2 id="pagamentos-title" class="border-b border-ink-100 px-5 py-4 font-semibold text-ink-900">Pagamentos</h2>
      <% if @payments.empty? %>
        <p class="px-5 py-6 text-sm text-ink-500">Nenhum pagamento registrado.</p>
      <% else %>
        <ul class="divide-y divide-ink-100" role="list">
          <% @payments.each do |payment| %>
            <li class="flex flex-wrap items-center gap-3 px-5 py-3">
              <div class="min-w-0 flex-1">
                <p class="sv-num text-sm font-medium text-ink-900"><%= money(payment.amount) %> · <%= payment.method_label %></p>
                <p class="text-xs text-ink-500">
                  <%= date_time(payment.paid_at) %> · <%= payment.recorded_by&.user&.name || "Provedor de pagamento" %>
                  <% if payment.refunded_amount.positive? %> · estornado <%= money(payment.refunded_amount) %><% end %>
                </p>
                <% payment.refunds.each do |refund| %>
                  <div class="mt-2 flex flex-wrap items-center gap-2 rounded-xl bg-ink-50 px-3 py-2 text-xs">
                    <span class="sv-num font-medium text-ink-800">Estorno <%= money(refund.amount) %></span>
                    <%= badge(refund.status_label, tone: { "accepted" => :success, "pending" => :info, "unknown" => :warning, "failed" => :danger, "manual" => :warning }.fetch(refund.status)) %>
                    <% if refund.last_error.present? %><span class="text-rose-700"><%= refund.last_error %></span><% end %>
                    <% if rp.refund? && refund.needs_attention? %>
                      <span class="ml-auto flex gap-2">
                        <%= button_to (refund.status == "manual" ? "Marcar como executado" : "Confirmado no provedor"), resolve_receivable_refund_path(@receivable, refund),
                              method: :patch, params: { resolution: { action: "confirm" } }, class: "sv-btn-ghost sv-btn-sm",
                              form: { data: { turbo_confirm: "Confirmar que o estorno foi executado?" } } %>
                        <% if refund.status == "unknown" || refund.status == "failed" %>
                          <%= button_to "Reenviar ao provedor", resolve_receivable_refund_path(@receivable, refund), method: :patch,
                                params: { resolution: { action: "retry" } }, class: "sv-btn-ghost sv-btn-sm",
                                form: { data: { turbo_confirm: "Reenviar somente se o estorno NÃO aparece no provedor. Continuar?" } } %>
                        <% end %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <% if rp.refund? && payment.refundable.positive? %>
                <details class="relative">
                  <summary class="sv-btn-ghost sv-btn-sm cursor-pointer list-none">Estornar</summary>
                  <%= form_with url: refund_receivable_payment_path(@receivable, payment), method: :patch, scope: :refund,
                        class: "absolute right-0 z-10 mt-2 w-72 space-y-2 rounded-2xl border border-ink-200 bg-white p-4 shadow-[var(--shadow-float)]" do |f| %>
                    <div><%= f.label :amount, "Valor do estorno (R$)", class: "sv-label", for: "estorno-#{payment.id}" %><%= f.number_field :amount, id: "estorno-#{payment.id}", value: payment.refundable.to_s("F"), step: "0.01", min: "0.01", max: payment.refundable.to_s("F"), class: "sv-input", required: true %></div>
                    <div><%= f.label :reason, "Motivo", class: "sv-label", for: "estorno-motivo-#{payment.id}" %><%= f.text_field :reason, id: "estorno-motivo-#{payment.id}", class: "sv-input", required: true %></div>
                    <p class="text-xs text-ink-500"><%= payment.payment_charge_id ? "O estorno será enviado ao provedor de pagamento." : "Pagamento manual: a devolução é feita pela equipe financeira." %></p>
                    <%= f.button "Registrar estorno", type: "submit", class: "sv-btn-danger w-full" %>
                  <% end %>
                </details>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="sv-card overflow-hidden" aria-labelledby="cobrancas-title">
      <h2 id="cobrancas-title" class="border-b border-ink-100 px-5 py-4 font-semibold text-ink-900">Cobranças</h2>
      <% if @charges.empty? %>
        <p class="px-5 py-6 text-sm text-ink-500">Nenhuma cobrança emitida. Provedor configurado: <%= @integration.provider_label %>.</p>
      <% else %>
        <ul class="divide-y divide-ink-100" role="list">
          <% @charges.each do |charge| %>
            <li class="flex flex-wrap items-center gap-3 px-5 py-3">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-ink-900"><span class="sv-num"><%= money(charge.amount) %></span> · <%= charge.billing_type_label %> · <%= charge.provider_label %></p>
                <p class="text-xs text-ink-500">
                  Referência <span class="font-mono"><%= charge.external_reference %></span> · vence <%= date(charge.due_on) %>
                  <% if charge.last_error.present? %><span class="block text-rose-700"><%= charge.last_error %></span><% end %>
                </p>
              </div>
              <%= badge(charge.status_label, tone: { "confirmed" => :success, "failed" => :danger, "unknown" => :warning, "canceled" => :neutral }.fetch(charge.status, :info)) %>
              <% if charge.payment_url.present? %>
                <%= link_to "Abrir cobrança", charge.payment_url, class: "sv-btn-ghost sv-btn-sm", target: "_blank", rel: "noopener noreferrer" %>
              <% end %>
              <% if rp.charge? && charge.simulated? && charge.status == "submitted" %>
                <%= button_to "Simular pagamento", simulate_receivable_charge_path(@receivable, charge), class: "sv-btn-secondary sv-btn-sm" %>
              <% end %>
              <% if rp.charge? && %w[submitted unknown].include?(charge.status) %>
                <%= button_to "Consultar situação", sync_receivable_charge_path(@receivable, charge), class: "sv-btn-ghost sv-btn-sm" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="sv-card p-5" aria-labelledby="historico-title">
      <h2 id="historico-title" class="mb-3 font-semibold text-ink-900">Histórico</h2>
      <ol class="space-y-3 border-l border-ink-200 pl-4" role="list">
        <% @events.each do |event| %>
          <li class="text-sm">
            <p class="font-medium text-ink-900"><%= event.label %><% if event.amount %> · <span class="sv-num"><%= money(event.amount) %></span><% end %></p>
            <p class="text-xs text-ink-500"><%= date_time(event.occurred_at) %> · <%= event.actor_label || "Sistema" %></p>
            <% detail = event.details["reason"] || event.details["error"] || event.details["attention"] %>
            <% if detail.present? %><p class="text-ink-600"><%= detail %></p><% end %>
          </li>
        <% end %>
      </ol>
    </section>
  </div>

  <aside class="space-y-6">
    <section class="sv-card p-5 text-sm" aria-labelledby="dados-title">
      <h2 id="dados-title" class="mb-2 font-semibold text-ink-900">Dados</h2>
      <p class="text-ink-700"><%= @receivable.customer.display_name %></p>
      <p class="text-ink-500">Vencimento <%= date(@receivable.due_on) %></p>
      <% if policy(@receivable.work_order).show? %>
        <p class="mt-2"><%= link_to "Ordem #{@receivable.work_order.number}", work_order_path(@receivable.work_order), class: "sv-link" %></p>
      <% end %>
    </section>

    <% if rp.register_payment? || rp.discount? || rp.charge? || rp.cancel? %>
      <section class="sv-card space-y-3 p-5" aria-labelledby="acoes-title">
        <h2 id="acoes-title" class="font-semibold text-ink-900">Ações</h2>
        <% if rp.register_payment? %>
          <%= link_to new_receivable_payment_path(@receivable), class: "sv-btn-primary w-full", data: { turbo_frame: "modal" } do %><%= icon(:plus, size: 18) %> Registrar pagamento<% end %>
        <% end %>
        <% if rp.charge? && active_charge.nil? %>
          <%= form_with url: receivable_charges_path(@receivable), scope: :charge, class: "flex gap-2" do |f| %>
            <%= f.label :billing_type, "Forma da cobrança", class: "sr-only" %>
            <%= f.select :billing_type, PaymentCharge::BILLING_TYPES.map { |v, l| [l, v] }, { selected: @integration.default_billing_type }, class: "sv-input" %>
            <%= f.button "Gerar cobrança", type: "submit", class: "sv-btn-secondary whitespace-nowrap" %>
          <% end %>
        <% end %>
        <% if rp.discount? %>
          <%= link_to "Conceder desconto", new_receivable_discount_path(@receivable), class: "sv-btn-ghost w-full", data: { turbo_frame: "modal" } %>
        <% end %>
        <% if rp.cancel? %>
          <details>
            <summary class="sv-btn-ghost w-full cursor-pointer list-none text-rose-700">Cancelar conta</summary>
            <%= form_with url: cancel_receivable_path(@receivable), method: :patch, scope: :cancellation, class: "mt-3 space-y-2" do |f| %>
              <%= f.label :reason, "Motivo do cancelamento", class: "sv-label" %>
              <%= f.text_field :reason, class: "sv-input", required: true %>
              <%= f.button "Confirmar cancelamento", type: "submit", class: "sv-btn-danger w-full" %>
            <% end %>
          </details>
        <% end %>
      </section>
    <% end %>
  </aside>
</div>

<% content_for :title, "Eventos" %>
<%= page_header("Eventos assíncronos", eyebrow: "Gestão · Eventos", subtitle: "Processamento da outbox: notificações, e-mails e integrações disparados pelas operações.") %>

<%= render "shared/filter_chips", label: "Filtrar por situação", items:
      [[nil, "Requer atenção"], ["dead", "Falha definitiva"], ["pending", "Pendentes"], ["processing", "Em processamento"], ["processed", "Processados"]].map { |value, text|
        [text, outbox_events_path(situacao: value), @status == value, (@counts[value] if value)]
      } %>

<section class="sv-card overflow-hidden">
  <% if @pagination.records.empty? %>
    <%= empty_state("Nada por aqui", description: "Nenhum evento nesta situação.", icon_name: :check) %>
  <% else %>
    <div class="relative overflow-x-auto">
      <table class="sv-table">
        <thead><tr><th scope="col">Evento</th><th scope="col">Situação</th><th scope="col">Tentativas</th><th scope="col">Criado</th><th scope="col"><span class="sr-only">Detalhes</span></th></tr></thead>
        <tbody class="divide-y divide-ink-150">
          <% @pagination.records.each do |event| %>
            <tr>
              <td><code class="font-mono text-xs font-medium text-ink-800"><%= event.event_type %></code></td>
              <td><%= render "outbox_events/status", event: %></td>
              <td class="sv-num font-mono text-xs text-ink-700"><%= event.attempts %>/<%= event.max_attempts %></td>
              <td class="sv-num whitespace-nowrap font-mono text-xs text-ink-600"><%= l(event.created_at, format: :short) %></td>
              <td class="text-right"><%= link_to "Detalhes", outbox_event_path(event), class: "sv-btn-ghost sv-btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
<%= render "shared/pagination", pagination: @pagination %>

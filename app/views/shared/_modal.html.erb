<%# Modal dialog loaded into the "modal" Turbo Frame. Uses the native <dialog>
    (focus trap, Escape, inert background). Without Turbo the same content is
    rendered as a regular page. %>
<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <dialog data-controller="modal" data-action="close->modal#closed"
            class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-2xl border border-ink-200 bg-white p-0 shadow-[var(--shadow-float)] backdrop:bg-ink-950/50 backdrop:backdrop-blur-sm"
            aria-labelledby="modal-title">
      <div class="flex items-start justify-between gap-4 border-b border-ink-100 px-6 py-4">
        <div>
          <h2 id="modal-title" class="text-lg font-semibold text-ink-950"><%= title %></h2>
          <% if local_assigns[:subtitle] %><p class="text-sm text-ink-500"><%= subtitle %></p><% end %>
        </div>
        <button type="button" class="-mr-2 rounded-lg p-2 text-ink-500 hover:bg-ink-100 hover:text-ink-700" data-action="modal#close" aria-label="Fechar">
          <%= icon(:close, size: 18) %>
        </button>
      </div>
      <div id="modal-body" class="max-h-[75vh] overflow-y-auto px-6 py-5">
        <%= yield %>
      </div>
    </dialog>
  <% end %>
<% else %>
  <%= page_header(title, subtitle: local_assigns[:subtitle]) %>
  <section class="sv-card max-w-2xl p-6"><%= yield %></section>
<% end %>

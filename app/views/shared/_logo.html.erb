<%# Servora mark: the cut gem. Flat facets, no gradients, so it stays crisp at small sizes. %>
<% size = local_assigns.fetch(:size, 28) %>
<% tone = local_assigns.fetch(:tone, :dark) %>
<span class="inline-flex items-center gap-2">
  <svg width="<%= size %>" height="<%= size %>" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
    <path d="M3 15 12.5 7 11.5 15Z" fill="#d91f3c"/>
    <path d="M12.5 7 20 15H11.5Z" fill="#c8102e"/>
    <path d="M12.5 7H27.5L20 15Z" fill="#e8475f"/>
    <path d="M27.5 7 28.5 15H20Z" fill="#a80c28"/>
    <path d="M27.5 7 37 15H28.5Z" fill="#8c0e26"/>
    <path d="M3 15H11.5L20 36Z" fill="#c8102e"/>
    <path d="M11.5 15H20V36Z" fill="#a80c28"/>
    <path d="M20 15H28.5L20 36Z" fill="#8c0e26"/>
    <path d="M28.5 15H37L20 36Z" fill="#6b0d20"/>
    <path d="M12.5 7H19L15.5 11Z" fill="#ffffff" fill-opacity="0.3"/>
  </svg>
  <% unless local_assigns[:mark_only] %>
    <span class="text-[17px] font-semibold tracking-tight <%= tone == :light ? 'text-white' : 'text-ink-950' %>">Servora</span>
  <% end %>
</span>

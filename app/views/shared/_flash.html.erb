<%# Toast notifications. Alerts use role="alert"; notices use role="status". %>
<% messages = local_assigns.fetch(:flash_messages) { flash.to_hash } %>
<div class="pointer-events-none fixed inset-x-0 top-4 z-50 flex flex-col items-center gap-2 px-4 sm:items-end sm:pr-6">
  <% messages.each do |type, message| %>
    <% next if message.blank? || !%w[notice alert].include?(type.to_s) %>
    <% alert = type.to_s == "alert" %>
    <div class="pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-2xl border bg-white p-4 shadow-[var(--shadow-float)] animate-slide-up <%= alert ? 'border-rose-200' : 'border-emerald-200' %>"
         role="<%= alert ? 'alert' : 'status' %>" data-controller="flash" data-flash-timeout-value="<%= alert ? 9000 : 5000 %>">
      <%= icon(alert ? :alert : :check, css: alert ? "text-rose-600 mt-0.5" : "text-emerald-600 mt-0.5") %>
      <p class="flex-1 text-sm font-medium text-ink-800"><%= message %></p>
      <button type="button" class="-m-1 rounded-lg p-1 text-ink-500 hover:bg-ink-100 hover:text-ink-700" data-action="flash#dismiss" aria-label="Fechar aviso">
        <%= icon(:close, size: 16) %>
      </button>
    </div>
  <% end %>
</div>

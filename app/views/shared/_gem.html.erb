<%# Servora gem: the cut ruby of the brand mark, drawn with flat facets. Decorative only. %>
<svg viewBox="0 0 400 360" fill="none" aria-hidden="true" focusable="false" class="<%= local_assigns[:class] %>">
  <g stroke="#ffffff" stroke-opacity="0.14" stroke-width="1" stroke-linejoin="round">
    <%# Crown %>
    <path d="M60 170 140 110 130 170Z" fill="#d91f3c"/>
    <path d="M140 110 200 170H130Z" fill="#c8102e"/>
    <path d="M140 110H260L200 170Z" fill="#e8475f"/>
    <path d="M260 110 270 170H200Z" fill="#a80c28"/>
    <path d="M260 110 340 170H270Z" fill="#8c0e26"/>
    <%# Pavilion %>
    <path d="M60 170H130L200 330Z" fill="#c8102e"/>
    <path d="M130 170H200V330Z" fill="#a80c28"/>
    <path d="M200 170H270L200 330Z" fill="#8c0e26"/>
    <path d="M270 170H340L200 330Z" fill="#6b0d20"/>
  </g>
  <path d="M140 110H195L168 142Z" fill="#ffffff" fill-opacity="0.28"/>
  <%# A single glint when the page opens; static under reduced motion. %>
  <path class="animate-glint-once origin-center [transform-box:fill-box]" fill="#ffffff"
        d="M168 96c1.2 6.4 3.6 8.8 10 10-6.4 1.2-8.8 3.6-10 10-1.2-6.4-3.6-8.8-10-10 6.4-1.2 8.8-3.6 10-10Z"/>
</svg>

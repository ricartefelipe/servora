<% content_for :title, "Recuperar senha" %>
<%= render "shared/auth_heading", title: "Recuperar senha", subtitle: "Enviaremos um link válido por 2 horas para redefinir sua senha." %>
<%= form_for resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" } do |f| %>
  <%= f.field :email, label: "E-mail", as: :email_field, autocomplete: "email", autofocus: true, required: true %>
  <%= f.submit_button "Enviar link", class: "w-full" %>
<% end %>
<p class="mt-6 text-sm"><%= link_to "Voltar ao login", new_session_path(resource_name), class: "sv-link" %></p>

<% content_for :title, "Novo orçamento" %>
<%= page_header("Novo orçamento", subtitle: "Escolha o local de atendimento. Os itens são incluídos em seguida.") %>
<% if @customers.empty? %>
  <section class="sv-card"><%= empty_state("Cadastre um cliente primeiro", icon_name: :customers) { link_to("Novo cliente", new_customer_path, class: "sv-btn-primary") } %></section>
<% else %>
  <%= form_with url: quotes_path, scope: :quote, class: "sv-card max-w-2xl space-y-5 p-6" do |f| %>
    <div>
      <%= f.label :service_location_id, "Cliente e local", class: "sv-label" %>
      <%= f.select :service_location_id, grouped_options_for_select(@customers.map { |customer|
            [customer.display_name, customer.service_locations.select { |l| l.archived_at.nil? }.map { |l| ["#{l.name} — #{l.city}/#{l.state}", l.id] }]
          }.reject { |_, locations| locations.empty? }, params[:service_location_id]), {}, class: "sv-input", required: true %>
    </div>
    <div>
      <%= f.label :title, "Título", class: "sv-label" %>
      <%= f.text_field :title, class: "sv-input", placeholder: "Ex.: Manutenção corretiva da câmara fria", maxlength: 160 %>
    </div>
    <%= f.button "Criar orçamento", type: "submit", class: "sv-btn-primary" %>
  <% end %>
<% end %>

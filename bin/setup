#!/usr/bin/env ruby
# frozen_string_literal: true

# Local bootstrap. Expects PostgreSQL from `docker compose up -d db mailpit`.
require "fileutils"
require "rbconfig"

APP_ROOT = File.expand_path("..", __dir__)
RUBY = RbConfig.ruby

def system!(*args, **opts)
  system(*args, exception: true, **opts)
end

FileUtils.chdir APP_ROOT do
  puts "== Instalando dependências =="
  system!("bundle check") || system!("bundle install")

  puts "\n== Preparando bancos (desenvolvimento e testes) =="
  system!(RUBY, "bin/db-prepare", "--seed")
  system!({ "RAILS_ENV" => "test" }, RUBY, "bin/db-prepare")

  puts "\n== Compilando CSS =="
  system!(RUBY, "bin/rails", "tailwindcss:build")

  puts "\n== Limpando logs e temporários =="
  system!(RUBY, "bin/rails", "log:clear", "tmp:clear")

  unless ARGV.include?("--skip-server")
    puts "\n== Iniciando servidor =="
    exec("sh", "bin/dev")
  end
end
